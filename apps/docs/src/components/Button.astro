---
// ボタン。semantic の変数(--color-*、--space-*、--radius-*、--size-hit)だけを参照する。
const { variant = "primary", loading = false, disabled = false, type = "button", force } = Astro.props;
---
<button
  type={type}
  class:list={["ds-btn", `ds-btn--${variant}`, force && `is-${force}`]}
  disabled={disabled}
  aria-busy={loading ? "true" : undefined}
  data-loading={loading ? "" : undefined}
>
  {loading && <span class="ds-btn__spin" aria-hidden="true"></span>}
  <span><slot /></span>
</button>

<style is:global>
  .ds-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    min-height: var(--size-hit); padding: 0 var(--space-4);
    border: 1px solid transparent; border-radius: var(--radius-2);
    font: inherit; font-size: var(--font-size-3); font-weight: var(--font-weight-strong); line-height: 1;
    cursor: pointer;
    transition: background-color var(--motion-duration-fast) var(--motion-ease), border-color var(--motion-duration-fast) var(--motion-ease);
  }
  .ds-btn--primary { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
  .ds-btn--primary:hover, .ds-btn--primary.is-hover { background: var(--color-primary-hover); border-color: var(--color-primary-hover); }
  .ds-btn--secondary { background: var(--color-surface); color: var(--color-text); border-color: var(--color-line-strong); }
  .ds-btn--secondary:hover, .ds-btn--secondary.is-hover { background: var(--color-surface-2); }
  .ds-btn:focus-visible, .ds-btn.is-focus { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .ds-btn:disabled { background: var(--color-surface-2); color: var(--color-text-muted); border-color: var(--color-line); cursor: not-allowed; }
  .ds-btn[data-loading] { cursor: progress; pointer-events: none; }
  .ds-btn__spin {
    width: 14px; height: 14px; border-radius: 50%;
    border: 2px solid currentColor; border-right-color: transparent;
    animation: ds-spin 800ms linear infinite;
  }
  @keyframes ds-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .ds-btn__spin { animation: none; border-right-color: currentColor; border-style: dotted; }
  }
</style>
