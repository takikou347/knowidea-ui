---
import "knowidea-tokens/dist/tokens.css";
import "knowidea-css/index.css";
import "../styles/docs.css";
import DocsNav from "../components/DocsNav.astro";
import { links } from "../lib/paths.mjs";
import { components } from "../lib/registry.mjs";
import { flat, topNav } from "../lib/nav.mjs";
import { editUrl } from "../lib/source.mjs";
import { site, basePath } from "../site.config.mjs";
import ui from "knowidea-ui/package.json";

// notFound: 404 ページ。どの深さの URL でも配られるので、<base> で根を固定する(相対の道がそれを基準にする)
const { title, description = site.description, toc = true, notFound = false, home = false } = Astro.props;
const l = links(Astro.url.pathname);
const { href, rel, current } = l;
const fullTitle = `${title} | ${site.name}`;
const pageUrl = notFound ? null : site.url + (current ? current + ".html" : "");
const pos = notFound ? -1 : flat.findIndex((p) => p.href === current);
const prev = pos > 0 ? flat[pos - 1] : null;
const next = pos >= 0 && pos < flat.length - 1 ? flat[pos + 1] : null;
const sectionOf = (c) => c.split("/")[0];
const edit = notFound ? null : editUrl(current);
const baseTag = notFound && import.meta.env.PROD ? basePath : null;
const index = components.map((c) => ({ n: c.name, c: c.catName, h: href("components/" + c.slug) }));
const icon = (name) => `<svg class="ki-icon" aria-hidden="true"><use href="${rel}sprite.svg#${name}"/></svg>`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {baseTag && <base href={baseTag} />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={site.url + "og.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}。${site.description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans+JP:wght@400;600&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        var t = localStorage.getItem("ki-docs-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href={notFound ? "./404.html#main" : "#main"}>Skip to content</a>
    <header class="docs-top" data-home={home ? "" : undefined}>
      <button type="button" class="ki-button ki-icon-button docs-menu" data-variant="quiet" data-ki-dialog-open="docs-drawer" aria-label="Open navigation">
        <Fragment set:html={icon("menu")} />
      </button>
      <a class="docs-brand" href={href("")}>
        <img class="docs-mark docs-mark-light" src="/mark.svg" alt="" width="28" height="28" />
        <img class="docs-mark docs-mark-dark" src="/mark-white.svg" alt="" width="28" height="28" />
        <span class="docs-name">KNOW IDEA UI</span>
        <span class="docs-ver"><span class="num">v{ui.version}</span></span>
      </a>
      <nav class="docs-topnav" aria-label="Main">
        {topNav.map((t) => <a href={href(t.href)} aria-current={!notFound && t.section.includes(sectionOf(current)) ? "true" : undefined}>{t.label}</a>)}
      </nav>
      <div class="docs-search">
        <button type="button" class="docs-searchbtn" data-docs-search-open aria-haspopup="dialog" aria-keyshortcuts="/ Control+K">
          <span class="docs-searchbtn-label"><Fragment set:html={icon("search")} />Search</span>
          <kbd class="docs-kbd" aria-hidden="true">/</kbd>
        </button>
      </div>
      <button type="button" class="ki-button docs-theme" data-variant="quiet" id="theme-toggle" aria-label="Toggle theme" data-mode="auto">
        <span class="docs-theme-sun"><Fragment set:html={icon("sun")} /></span>
        <span class="docs-theme-moon"><Fragment set:html={icon("moon")} /></span>
        <span class="docs-theme-label" id="theme-label">Theme: Auto</span>
      </button>
      <a class="docs-gh" href={site.repo} rel="noopener">GitHub</a>
    </header>
    {home ? (
      <main id="main" class="home">
        <slot />
        <footer class="docs-foot home-foot">
          <ul class="docs-meta">
            <li><a class="docs-meta-link" href={href("changelog")}>Changelog</a></li>
            <li><a class="docs-meta-link" href={site.repo} rel="noopener">GitHub</a></li>
            <li class="docs-meta-ver"><code>knowidea-ui</code> <span class="num">v{ui.version}</span></li>
          </ul>
        </footer>
      </main>
    ) : (
    <div class="docs-body" data-toc={toc ? "" : undefined}>
      <aside class="docs-nav" aria-label="Site navigation">
        <DocsNav l={l} />
      </aside>
      <main id="main" class="docs-main">
        <slot />
        {!notFound && (
          <footer class="docs-foot">
            {(prev || next) && (
              <nav class="docs-pn" aria-label="Previous and next pages">
                {prev ? <a class="docs-pn-prev" rel="prev" href={href(prev.href)}><span class="docs-pn-dir">Previous</span><span class="docs-pn-name">{prev.label}</span></a> : <span />}
                {next ? <a class="docs-pn-next" rel="next" href={href(next.href)}><span class="docs-pn-dir">Next</span><span class="docs-pn-name">{next.label}</span></a> : <span />}
              </nav>
            )}
            <ul class="docs-meta">
              {edit && <li><a class="docs-meta-link" href={edit} rel="noopener">Edit this page</a></li>}
              <li><a class="docs-meta-link" href={href("changelog")}>Changelog</a></li>
              <li><a class="docs-meta-link" href={site.repo} rel="noopener">GitHub</a></li>
              <li class="docs-meta-ver"><code>knowidea-ui</code> <span class="num">v{ui.version}</span></li>
            </ul>
          </footer>
        )}
      </main>
      {toc && (
        <aside class="docs-toc" aria-label="On this page">
          <p class="docs-toc-title">On this page</p>
          <ul id="docs-toc-list"></ul>
        </aside>
      )}
    </div>
    )}
    <dialog id="docs-drawer" class="ki-drawer" data-variant="temporary" aria-label="Navigation">
      <div class="ki-drawer__head">
        <p class="ki-drawer__brand"><b>KNOW IDEA UI</b><span>v{ui.version}</span></p>
        <button type="button" class="ki-button ki-icon-button" data-variant="quiet" data-ki-dialog-close aria-label="Close navigation"><Fragment set:html={icon("close")} /></button>
      </div>
      <DocsNav l={l} />
      <p class="docs-drawer-foot"><a href={site.repo} rel="noopener">GitHub</a></p>
    </dialog>
    <dialog id="docs-sd" class="docs-sd" aria-label="Search" data-index={rel + "search-index.json"}>
      <div class="docs-sd-bar">
        <label class="ki-sr-only" for="docs-q">Search</label>
        <input id="docs-q" class="ki-input" type="search" placeholder="Search pages and sections" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="docs-q-list" aria-autocomplete="list" />
        <button type="button" class="ki-button" data-variant="quiet" data-docs-search-close>Close</button>
      </div>
      <ul id="docs-q-list" class="docs-results" role="listbox" aria-label="Search results"></ul>
      <p id="docs-q-hint" class="docs-sd-hint">ページと見出しを探す。<kbd class="docs-kbd">/</kbd> か <kbd class="docs-kbd">Ctrl</kbd> <kbd class="docs-kbd">K</kbd> でどのページからも開く。</p>
      <p class="ki-sr-only" id="docs-q-status" role="status"></p>
    </dialog>
    <dialog id="cp-dialog" class="docs-sd cp-dialog" aria-labelledby="cp-title">
      <div class="cp-dialog-head">
        <h2 class="cp-dialog-title" id="cp-title">Code</h2>
        <button type="button" class="ki-button ki-icon-button" data-variant="quiet" data-cp-close aria-label="Close code"><Fragment set:html={icon("close")} /></button>
      </div>
      <div class="cp-dialog-bar">
        <div role="tablist" aria-label="Language" class="cp-tabs" style="display:flex;gap:var(--space-2)">
          <button type="button" role="tab" class="ki-button" data-variant="secondary" data-cp-tab="react" aria-selected="true">React</button>
          <button type="button" role="tab" class="ki-button" data-variant="secondary" data-cp-tab="html" aria-selected="false">HTML</button>
        </div>
        <button type="button" class="ki-button cp-copy" data-variant="secondary" data-cp-copy>Copy</button>
      </div>
      <pre class="ki-code__pre" tabindex="0" aria-label="Code"><code id="cp-code"></code></pre>
      <p class="cp-dialog-status" id="cp-status" role="status"></p>
    </dialog>
    <script define:vars={{ index }} is:inline>
      window.__docsIndex = index;
    </script>
    <script>
      import "knowidea-css/enhance.js";
      import "../scripts/chrome.js";
    </script>
  </body>
</html>
