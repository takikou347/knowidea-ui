---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Dividers } from "../../demos/misc.tsx";
const html = `<p>上の文</p>
<hr class="ki-divider" />
<p>下の文</p>
<div class="ki-divider-label"><span>または</span></div>
<span>一覧<span class="ki-divider" data-orientation="vertical" role="separator" aria-orientation="vertical"></span>記録</span>`;
---
<ComponentPage
  title="区切り"
  lead="内容の切れ目に 1 本の線。区切りは線 1 つで足り、影や面を重ねない。ラベル付きは文の切れ目に使う。"
  props={[
    ["orientation", '"horizontal" | "vertical"', '"horizontal"', "横か縦"],
    ["strong", "boolean", "false", "濃い線(--color-line-strong)"],
    ["label", "string", "-", "切れ目の語(横だけ)"],
  ]}
  attrs={[[".ki-divider", "hr に付ける"], ['data-orientation="vertical"', "縦。span に付ける"], ["data-strong", "濃い線"], [".ki-divider-label", "ラベル付き"]]}
  vars={[["--color-line、--color-line-strong", "線"], ["--space-3、--space-4", "前後の余白"]]}
  html={html}
>
  <Fragment slot="demo"><Dividers client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="該当しない" />
    <StateRow label="読み込み" na="該当しない" />
    <StateRow label="失敗" na="該当しない" />
    <StateRow label="無効" na="該当しない" />
    <StateRow label="focus" na="該当しない。focus を受けない" />
    <StateRow label="hover" na="該当しない" />
    <StateRow label="押した時" na="該当しない" />
  </Fragment>
</ComponentPage>
