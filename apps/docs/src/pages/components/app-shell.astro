---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Shell } from "../../demos/admin.tsx";
import { ic } from "../../lib/html.mjs";
const html = `<div class="ki-shell">
  <div class="ki-shell__frame">
    <aside class="ki-side" aria-label="目次">
      <p class="ki-side__brand"><b>KNOW IDEA</b><span>管理</span></p>
      <nav aria-label="主な画面"><ul class="ki-side__list">
        <li><a class="ki-side__item" href="/" aria-current="page">${ic("home")}ホーム</a></li>
        <li><a class="ki-side__item" href="/threads">${ic("thread")}スレッドと PR</a></li>
      </ul></nav>
    </aside>
    <div class="ki-shell__col">
      <header class="ki-topbar"><h1 class="ki-topbar__title">ホーム</h1><p class="ki-topbar__meta"><span>日本時間</span><time>10/13 09:41</time></p></header>
      <main class="ki-shell__main">…</main>
    </div>
    <nav class="ki-tabbar" aria-label="画面の切り替え"><ul class="ki-tabbar__list">
      <li><a class="ki-tabbar__item" href="/" aria-current="page">${ic("home")}ホーム</a></li>
      <li><a class="ki-tabbar__item" href="/threads">${ic("thread")}スレッド</a></li>
    </ul></nav>
  </div>
</div>`;
---
<ComponentPage
  title="アプリの枠(AppShell)"
  lead="上のバー、iPhone の下のタブバー、iPad のサイドの目次。切り替えは画面でなく枠の幅(container query)で決め、720px 未満が上のバーと下のタブバー、720px 以上がサイドの目次。タブバーは 5 つまで、押せる所は 52px の高さ。今いる所は主の色と字の太さと線で示す。"
  props={[
    ["nav", "NavItem[]", "-", "{ id, label, icon, href, count? }。count はオーナー待ちの件数など"],
    ["current", "string", "-", "今いる所の id(aria-current=page)"],
    ["title", "string", "-", "上のバーの題(h1)"],
    ["asOf", "string", "-", "いつの数か(日本時間)"],
    ["actions", "ReactNode", "-", "上のバーの右の操作(IconButton)"],
    ["brand", "{ name, sub? }", '{ name: "KNOW IDEA", sub: "管理" }', "サイドの上の名前"],
    ["tabs", "string[]", "先頭の 5 つ", "下のタブバーに出す id"],
    ["frame", "number", "-", "見本のための枠の高さ(px)。実物では渡さない"],
  ]}
  attrs={[[".ki-shell[data-frame]", "枠。container を持つ。data-frame は見本の固定の高さ"], [".ki-side、__brand、__list、__item[aria-current]", "サイドの目次(720px 以上)"], [".ki-topbar、__title、__meta、__actions", "上のバー"], [".ki-tabbar、__list、__item[aria-current]、.ki-count", "下のタブバー(720px 未満)と件数の印"], [".ki-shell__main、.ki-screen[data-cols=2]、.ki-section、.ki-panel", "画面の中の並べ方。main の幅 640px 以上で 2 列"]]}
  vars={[["--color-bg、--color-surface、--color-line", "面と線"], ["--color-primary", "今いる所"], ["--size-hit", "押せる所"], ["--color-warn(-soft)", "件数の印"]]}
  html={html}
  htmlNote="枠の中に枠の幅の container query がある。ほかの CSS は不要。"
>
  <Fragment slot="demo">
    <div style="display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4);width:100%">
      <p class="muted" style="margin:0">幅 390px(iPhone)。下にタブバー。</p>
      <Shell width={390} tab frame={420} client:load />
      <p class="muted" style="margin:0">最大 1024px(iPad)。左にサイドの目次。</p>
      <Shell width={1024} frame={360} client:load />
    </div>
  </Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="枠は中身を持たない" />
    <StateRow label="読み込み" na="枠は読み込みを持たない。中の部品が持つ" />
    <StateRow label="失敗" na="失敗は中の画面が帯(Banner)で出す" />
    <StateRow label="無効" na="目次は無効にしない" />
    <StateRow label="focus" note="目次、タブに 2px の輪。タブは内側に出して切れないようにする。" />
    <StateRow label="hover" note="面が 1 段濃くなる。" />
    <StateRow label="押した時" note="今いる所が変わる(ページの移動)。" />
  </Fragment>
</ComponentPage>
