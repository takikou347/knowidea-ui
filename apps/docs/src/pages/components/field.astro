---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { InputField, Mixed } from "../../demos/field.tsx";
const html = `<div class="ki-field">
  <label class="ki-field__label" for="f1">routine 名<span class="ki-field__required">必須</span></label>
  <input id="f1" class="ki-input" aria-describedby="f1-hint" />
  <p id="f1-hint" class="ki-field__hint">英小文字とハイフンで書く</p>
</div>
<div class="ki-field" data-invalid>
  <label class="ki-field__label" for="f2">routine 名<span class="ki-field__required">必須</span></label>
  <input id="f2" class="ki-input" aria-invalid="true" aria-describedby="f2-err" value="Review Daily" />
  <p id="f2-err" class="ki-field__error">英小文字とハイフンだけが使える</p>
</div>`;
---
<ComponentPage
  title="欄(Field)"
  lead="ラベル、補足、誤りを入力部品にまとめる。ラベルと入力の結び付け、aria-describedby、aria-invalid は Base UI の Field が付ける。誤りは「何が悪いか」を 1 文で書く。"
  props={[
    ["label", "ReactNode", "-", "ラベル。必須"],
    ["hint", "ReactNode", "-", "補足。入力の前に知っておくこと"],
    ["error", "ReactNode", "-", "誤り。あると欄全体が失敗になり、入力の枠も変わる"],
    ["required", "boolean", "false", "ラベルに「必須」を足す。記号の * は使わない"],
    ["disabled", "boolean", "false", "欄全体を無効にする"],
    ["children", "ReactNode", "-", "Input、Textarea、Select、Checkbox など 1 つ"],
  ]}
  attrs={[[".ki-field", "欄の外枠(間隔 4px)"], [".ki-field__label、__required、__hint、__error", "ラベル、必須の印、補足、誤り"], ["[data-invalid]", "誤りのある欄"], [".ki-fieldset", "ラジオなどをまとめる。legend がラベルになる"]]}
  vars={[["--color-text、--color-text-muted、--color-error", "ラベル、補足、誤りの色"], ["--space-1", "ラベルと入力の間隔"], ["--font-size-2、--font-size-3", "補足と誤り、ラベル"]]}
  html={html}
>
  <Fragment slot="demo"><InputField client:load /><Mixed client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空"><InputField kind="empty" client:load /></StateRow>
    <StateRow label="読み込み"><InputField kind="loading" client:load /></StateRow>
    <StateRow label="失敗"><InputField kind="error" client:load /></StateRow>
    <StateRow label="無効"><InputField kind="disabled" client:load /></StateRow>
    <StateRow label="focus"><InputField kind="focus" client:load /></StateRow>
    <StateRow label="hover" na="欄は見た目を変えない。中の入力が変える" />
    <StateRow label="押した時" na="欄は押せない。ラベルを押すと入力に focus が移る" />
  </Fragment>
</ComponentPage>
