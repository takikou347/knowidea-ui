---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Statuses, StatusSizes } from "../../demos/admin.tsx";
import { status } from "../../lib/html.mjs";
const html = `${status("success", "working", "動いている")}
${status("warn", "paused", "待っている")}
${status("info", "review", "見てほしい")}
${status("", "success", "終わった")}
${status("error", "error", "失敗")}
${status("warn", "owner-wait", "オーナー待ち", "lg")}`;
---
<ComponentPage
  title="状態の印(StatusMark)"
  lead="Claude の状態 5 つと、提案とプロジェクトの状態 6 つ。色だけでなく、形(アイコンの輪郭)と字で分かる。提案とプロジェクトは lg にして一目で分かる大きさで出す。"
  props={[
    ["kind", '"claude" | "proposal"', '"claude"', "どちらの状態か"],
    ["status", "ClaudeStatus | ProposalStatus", "-", "Claude: working、blocked、review、done、failed。提案: discussing、reviewing、owner、building、done、dropped"],
    ["size", '"md" | "lg"', '"md"', "lg は提案とプロジェクトのカード用"],
  ]}
  attrs={[[".ki-status[data-tone]", "状態の印。data-tone は info、success、warn、error(無ければ中立)"], ["data-size=\"lg\"", "大きい印"]]}
  vars={[["--color-info / success / warn / error(-soft)", "字と面。全部 4.5:1 以上"], ["--color-surface-2、--color-text", "中立"], ["--radius-1、--radius-2", "角丸"]]}
  html={html}
>
  <Fragment slot="demo">
    <div style="display:grid;gap:var(--space-3);width:100%">
      <p class="muted" style="margin:0">Claude の状態(5 つ)</p><Statuses client:load />
      <p class="muted" style="margin:0">提案とプロジェクトの状態(6 つ)</p><Statuses kind="proposal" client:load />
      <p class="muted" style="margin:0">大きさ</p><StatusSizes client:load />
    </div>
  </Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="状態が無い対象は印を出さない" />
    <StateRow label="読み込み" na="状態が決まるまでは印を出さず、スケルトンを使う" />
    <StateRow label="失敗" note="Claude の「失敗」が失敗の状態。丸に × のアイコン、赤い字。"><Statuses client:load /></StateRow>
    <StateRow label="無効" na="印は押せない" />
    <StateRow label="focus" na="印は focus を受けない" />
    <StateRow label="hover" na="変わらない" />
    <StateRow label="押した時" na="押せない" />
  </Fragment>
</ComponentPage>
