---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Checkbox } from "@knowidea/react";
const html = `<label class="ki-choice"><input type="checkbox" class="ki-check" checked /><span>完了したら知らせる</span></label>
<label class="ki-choice"><input type="checkbox" class="ki-check" /><span>失敗したら知らせる</span></label>`;
---
<ComponentPage
  title="チェック"
  lead="独立した「入」と「切」。押せる所はラベルまで含めて 44px。複数から選ぶときは並べる。1 つだけ選ぶときはラジオを使う。"
  props={[
    ["label", "ReactNode", "-", "ラベル。無いときは aria-label を付ける"],
    ["checked / defaultChecked / onCheckedChange", "boolean", "-", "制御と非制御"],
    ["indeterminate", "boolean", "false", "一部だけ選んだ状態(全選択の見出しなど)"],
    ["invalid", "boolean", "false", "失敗の枠"],
    ["loading", "boolean", "false", "操作できず、回転を出す"],
    ["disabled", "boolean", "false", "押せない"],
  ]}
  attrs={[[".ki-choice > .ki-check", "素の HTML は <input type=\"checkbox\">。React は Base UI が同じクラスで描く"], ["[data-checked]、:checked、:indeterminate", "入"], ["[data-indeterminate]", "一部"]]}
  vars={[["--color-primary、--color-on-primary", "入の面と印"], ["--color-line-strong、--color-surface", "切の枠と面"], ["--color-error", "失敗"], ["--size-hit", "ラベルを含む押せる高さ"], ["--radius-1", "角丸"]]}
  html={html}
>
  <Fragment slot="demo"><Checkbox client:load label="完了したら知らせる" defaultChecked /><Checkbox client:load label="失敗したら知らせる" /><Checkbox client:load label="一部" indeterminate /></Fragment>
  <Fragment slot="states">
    <StateRow label="空"><Checkbox client:load label="切" /><Checkbox client:load label="入" defaultChecked /><Checkbox client:load label="一部" indeterminate /></StateRow>
    <StateRow label="読み込み"><Checkbox client:load label="保存中" loading /></StateRow>
    <StateRow label="失敗"><Checkbox client:load label="同意が要る" invalid /></StateRow>
    <StateRow label="無効"><Checkbox client:load label="切" disabled /><Checkbox client:load label="入" disabled defaultChecked /></StateRow>
    <StateRow label="focus"><Checkbox client:load label="切" className="is-focus" /></StateRow>
    <StateRow label="hover"><Checkbox client:load label="切" className="is-hover" /></StateRow>
    <StateRow label="押した時" na="押すと入と切が変わる。押している間の見た目は無い" />
  </Fragment>
</ComponentPage>
