---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Select } from "@knowidea/react";
const opts = [{ value: "daily", label: "毎日" }, { value: "weekly", label: "毎週" }, { value: "monthly", label: "毎月" }];
const html = `<span class="ki-select-wrap">
  <select class="ki-select" aria-label="間隔">
    <option>毎日</option><option>毎週</option><option>毎月</option>
  </select>
</span>`;
---
<ComponentPage
  title="選ぶ(Select)"
  lead="1 つを選ぶ。選択肢が 7 つ以内ならラジオも考える。React は Base UI の Select(キーボード、読み上げ込み)、素の HTML はブラウザの select。"
  props={[
    ["options", "{ value, label, disabled? }[]", "-", "選択肢。必須"],
    ["value / defaultValue / onValueChange", "string | null", "-", "制御と非制御"],
    ["placeholder", "string", '"選ぶ"', "未選択のときの文"],
    ["invalid", "boolean", "false", "失敗の枠"],
    ["loading", "boolean", "false", "開けなくなり、回転と「読み込み中」を出す"],
    ["disabled", "boolean", "false", "押せない"],
    ["aria-label", "string", "-", "欄(Field)の外で使うときの名前"],
  ]}
  attrs={[[".ki-select-wrap > select.ki-select", "素の HTML。右の矢印は wrap が出す"], ['aria-invalid="true"', "失敗"], [".ki-select__popup、.ki-select__item", "Base UI の一覧に当てるクラス"]]}
  vars={[["--color-surface、--color-line-strong、--color-surface-2", "面、枠、項目の hover"], ["--shadow-pop", "一覧の影(ポップする物)"], ["--size-hit、--radius-2、--radius-3", "高さ、角丸"]]}
  html={html}
  htmlNote="開いた一覧の見た目はブラウザに任せる。"
>
  <Fragment slot="demo"><div class="w"><Select client:load aria-label="間隔" options={opts} /></div></Fragment>
  <Fragment slot="states">
    <StateRow label="空"><div class="w"><Select client:load aria-label="空" options={opts} placeholder="間隔を選ぶ" /></div></StateRow>
    <StateRow label="読み込み"><div class="w"><Select client:load aria-label="読み込み" options={opts} loading /></div></StateRow>
    <StateRow label="失敗"><div class="w"><Select client:load aria-label="失敗" options={opts} invalid /></div></StateRow>
    <StateRow label="無効"><div class="w"><Select client:load aria-label="無効" options={opts} defaultValue="daily" disabled /></div></StateRow>
    <StateRow label="focus"><div class="w"><Select client:load aria-label="focus" options={opts} defaultValue="daily" className="is-focus" /></div></StateRow>
    <StateRow label="hover"><div class="w"><Select client:load aria-label="hover" options={opts} defaultValue="daily" className="is-hover" /></div></StateRow>
    <StateRow label="押した時" na="押すと一覧が開く。開いた状態は「デモ」で触れる" />
  </Fragment>
</ComponentPage>
<style is:global>.w { width: min(100%, 320px); }</style>
