---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Proposals, ProposalStates } from "../../demos/admin.tsx";
import { ic, status } from "../../lib/html.mjs";
const html = `<article class="ki-proposal">
  <p class="ki-proposal__org"><span>${ic("department")}本社</span><span>${ic("proposal")}提案</span><span>段 3 管理アプリ</span></p>
  <div class="ki-proposal__head">
    <h3 class="ki-proposal__title"><a class="ki-proposal__link" href="#">管理アプリの置き場とログインを決める</a></h3>
    ${status("warn", "owner-wait", "オーナー待ち", "lg")}
  </div>
  <p class="ki-proposal__need">${ic("owner-wait")}<span><b>オーナーに要ること</b> 置き場とログインに はい か いいえ</span></p>
</article>`;
---
<ComponentPage
  title="提案とプロジェクトのカード(ProposalCard)"
  lead="進行中の提案とプロジェクト。部署、段(計画の正本の段の名前)、状態 6 つ、オーナーに要ること、スレッドへのリンク。状態は大きな印で出し、遠くからも見分けられる。承認、否認、コメントはカードの下に置ける。"
  props={[
    ["kind", '"proposal" | "project"', '"proposal"', "提案かプロジェクトか"],
    ["title", "string", "-", "題(リンク)"],
    ["department", "string", "-", "部署"],
    ["stage", "string", "-", "段の名前(1c 部品 など)"],
    ["status", "ProposalStatus", "-", "discussing、reviewing、owner、building、done、dropped"],
    ["needsOwner", "string", "-", "オーナーに要ること。無ければ「無し」と出す"],
    ["href / onOpen", "string / () => void", "-", "カード全体のリンク"],
    ["actions", "ReactNode", "-", "下に置く操作(DecisionBar)"],
    ["state", '"ready" | "loading"', '"ready"', "読み込み中"],
  ]}
  attrs={[[".ki-proposal[data-state]", "カード"], [".ki-proposal__org、__head、__title、__link、__need、__none、__foot", "中の部品"]]}
  vars={[["--color-surface、--color-line", "面、線"], ["--color-warn(-soft)", "オーナーに要ること"], ["--color-info / success(-soft)", "状態の印"]]}
  html={html}
>
  <Fragment slot="demo"><Proposals client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" note="オーナーに要ることが無い。「無し」と出す。"><ProposalStates kind="none" client:load /></StateRow>
    <StateRow label="読み込み" note="スケルトン。"><ProposalStates kind="loading" client:load /></StateRow>
    <StateRow label="失敗" na="提案の取得に失敗するのは一覧全体。一覧の上に帯(Banner)を出す" />
    <StateRow label="無効" na="済みと見送りは操作を出さない(カードは残る)" />
    <StateRow label="focus" note="カードの外側に輪。"><ProposalStates kind="focus" client:load /></StateRow>
    <StateRow label="hover" note="線が 1 段濃くなる。"><ProposalStates kind="hover" client:load /></StateRow>
    <StateRow label="押した時" na="スレッドへ移る" />
  </Fragment>
</ComponentPage>
