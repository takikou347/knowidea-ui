---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Skeletons } from "../../demos/misc.tsx";
const html = `<div class="ki-skeleton-stack" aria-busy="true">
  <span class="ki-sr-only" role="status">読み込み中</span>
  <span class="ki-skeleton" data-size="long"></span>
  <span class="ki-skeleton" data-size="long"></span>
  <span class="ki-skeleton" data-size="medium"></span>
</div>`;
---
<ComponentPage
  title="読み込み(Skeleton)"
  lead="内容が来るまでの仮の形。動かさない(終わらない脈動は使わない)。包む側に aria-busy を付け、読み上げには「読み込み中」を 1 回だけ伝える。2 秒以上かかるときに出す。"
  props={[
    ["Skeleton: size", '"short" | "medium" | "long"', '"long"', "幅 30%、60%、100%"],
    ["Skeleton: shape", '"text" | "block"', '"text"', "1 行か、面"],
    ["SkeletonText: lines / label", "number / string", "3 / \"読み込み中\"", "文の仮の行。最後の行は短い"],
  ]}
  attrs={[[".ki-skeleton[data-size][data-shape]", "仮の形"], [".ki-skeleton-stack", "縦に並べる"]]}
  vars={[["--color-line", "面"], ["--radius-1、--radius-2", "角丸"], ["--space-3", "行の間"]]}
  html={html}
>
  <Fragment slot="demo"><Skeletons client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="該当しない。空は空の状態を使う" />
    <StateRow label="読み込み">この部品そのもの。</StateRow>
    <StateRow label="失敗" na="読み込みが失敗したら、スケルトンを消して帯を出す" />
    <StateRow label="無効" na="該当しない" />
    <StateRow label="focus" na="該当しない。focus を受けない" />
    <StateRow label="hover" na="該当しない" />
    <StateRow label="押した時" na="該当しない" />
  </Fragment>
</ComponentPage>
