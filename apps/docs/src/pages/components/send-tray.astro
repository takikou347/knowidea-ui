---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Tray, TrayFixed } from "../../demos/admin.tsx";
import { ic } from "../../lib/html.mjs";
const html = `<section class="ki-tray" aria-label="送る前の一覧">
  <div class="ki-tray__head">
    <div class="ki-tray__summary">
      <p class="ki-tray__count">送る前の一覧 <b>2</b> 件</p>
      <p class="ki-tray__phase" data-phase="idle" role="status">まとめて 1 回で送る。送る前は 1 件ずつ消せる。</p>
    </div>
    <div class="ki-tray__actions"><button type="button" class="ki-button" data-variant="primary">${ic("send")}<span>まとめて送る</span></button></div>
  </div>
</section>`;
---
<ComponentPage
  title="まとめて送るトレイ(SendTray)"
  lead="承認、否認、コメント、話しかけた文が貯まる、送る前の一覧。選んだ物の数、1 件ずつ消せる一覧、「まとめて送る」。送っている間も貯められ、次の送りに入る。送った後は「送っている」「受けた」「考えている」「済み」と進む。届かなければ一覧はそのまま残り、もう一度送れる。止めるボタンだけは急ぎなので、1 件で送り、このトレイを通らない。"
  props={[
    ["items", "TrayItem[]", "-", "{ id, kind (approve、reject、yes、no、comment、talk), target, text?, state (queued、sending、received、thinking、done、failed) }"],
    ["phase", '"idle" | "sending" | "received" | "failed"', '"idle"', "送りの進み方。sending は送っている、received は受けた"],
    ["onSend / onRemove", "() => void / (id) => void", "-", "まとめて送る、1 件消す(送る前と届かなかった物だけ)"],
    ["open / defaultOpen / onOpenChange", "boolean", "false", "一覧を開く"],
  ]}
  attrs={[[".ki-tray__head、__summary、__count、__phase[data-phase]、__actions", "上の段。件数と進み方とボタン"], [".ki-tray__list、__item、__kind、__body、__target、__text、__state、__empty", "一覧(開いたとき)"]]}
  vars={[["--color-line-strong", "枠"], ["--color-info / --color-error", "受けた、届かなかった"], ["--color-text-muted", "進み方の文、コメント"]]}
  html={html}
  htmlNote="開閉と送りの進み方は JS で data-phase と hidden を切り替える。"
>
  <Fragment slot="demo"><Tray client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" note="何も貯まっていない。「送る物は無い」と出し、送るボタンは押せない。"><TrayFixed kind="empty" client:load /></StateRow>
    <StateRow label="閉じた" note="件数だけ。ボタンで開く。"><TrayFixed kind="closed" client:load /></StateRow>
    <StateRow label="読み込み" note="送っている。ボタンは回転を出して押せない。この間も貯められる。"><TrayFixed kind="sending" client:load /></StateRow>
    <StateRow label="受けた" note="受け口が受けた後。済みの物と、答えを待つ物(考えている)が並ぶ。"><TrayFixed kind="done" client:load /></StateRow>
    <StateRow label="失敗" note="届かなかった。一覧はそのまま残り、「もう一度送る」。"><TrayFixed kind="failed" client:load /></StateRow>
    <StateRow label="無効" note="送っている間と済みの物は、1 件ずつの取り消しが押せない。" />
    <StateRow label="focus" note="ボタンと取り消しに輪が出る。" />
    <StateRow label="hover / 押した時" note="ボタンのページと同じ。" />
  </Fragment>
</ComponentPage>
