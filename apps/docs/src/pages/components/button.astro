---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Button } from "@knowidea/react";
import { WithIcon } from "../../demos/button.tsx";

const variants = ["primary", "secondary", "quiet", "danger"] as const;
const html = `<button type="button" class="ki-button">承認する</button>
<button type="button" class="ki-button" data-variant="secondary">否認する</button>
<button type="button" class="ki-button" data-variant="quiet">あとで</button>
<button type="button" class="ki-button" data-variant="danger">削除する</button>
<button type="button" class="ki-button" data-variant="secondary" data-size="lg">大きいボタン</button>
<button type="button" class="ki-button" data-loading aria-busy="true"><span class="ki-spinner" aria-hidden="true"></span><span>送る</span></button>`;
---
<ComponentPage
  title="ボタン"
  lead="操作を実行する。ナビゲーションには使わない(リンクを使う)。主は 1 画面に 1 つ。危ない操作は danger にして、確かめるダイアログと組む。"
  props={[
    ["variant", '"primary" | "secondary" | "quiet" | "danger"', '"primary"', "主は 1 画面に 1 つ。静か(quiet)は枠も面も無い"],
    ["size", '"md" | "lg"', '"md"', "md は 44px、lg は 52px。どちらも押せる大きさ"],
    ["loading", "boolean", "false", "押せなくなり、aria-busy になる。ラベルはそのまま、先頭に回転が出る"],
    ["loadingLabel", "string", '"処理中"', "読み込み中に読み上げる文"],
    ["icon", "ReactNode", "-", "ラベルの前のアイコン。packages/icons の部品も渡せる"],
    ["disabled", "boolean", "false", "押せない。focus も入らない"],
    ["type", '"button" | "submit" | "reset"', '"button"', "form の中では submit を明示する"],
  ]}
  attrs={[
    [".ki-button", "ボタン本体。<button> か <a> に付ける"],
    ['data-variant="secondary | quiet | danger"', "無ければ primary"],
    ['data-size="lg"', "大きいボタン"],
    ["data-loading", "読み込み中。pointer-events を止める。aria-busy も付ける"],
    [".is-hover、.is-focus、.is-active", "見本のための固定。実物では使わない"],
  ]}
  vars={[
    ["--color-primary、--color-primary-hover、--color-on-primary", "primary の面、hover、文字"],
    ["--color-surface、--color-surface-2、--color-line、--color-line-strong", "secondary と quiet の面、hover、枠"],
    ["--color-error、--color-bg、--color-text", "danger の面、文字、hover の混ぜ色"],
    ["--color-focus", "focus の輪(2px)"],
    ["--radius-2、--space-2、--space-4、--space-5", "角丸、中の間隔、左右の余白"],
    ["--size-hit", "最小の高さ(44px)"],
    ["--font-size-3、--font-weight-strong", "文字"],
  ]}
  html={html}
  htmlNote="読み込み中の回転は ki-spinner。"
>
  <Fragment slot="demo">
    <Button>承認する</Button>
    <Button variant="secondary">否認する</Button>
    <Button variant="quiet">あとで</Button>
    <Button variant="danger">削除する</Button>
    <Button variant="secondary" size="lg">大きいボタン</Button>
    <WithIcon />
  </Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="ラベルが無いボタンは作らない。アイコンだけのときはアイコンボタンを使う" />
    <StateRow label="読み込み">
      {variants.map((v) => <Button variant={v} loading>送る</Button>)}
    </StateRow>
    <StateRow label="失敗" na="ボタン自身は失敗を持たない。押した結果の失敗は、近くの帯か欄の誤りで示す" />
    <StateRow label="無効">
      {variants.map((v) => <Button variant={v} disabled>送る</Button>)}
    </StateRow>
    <StateRow label="focus">
      {variants.map((v) => <Button variant={v} className="is-focus">送る</Button>)}
    </StateRow>
    <StateRow label="hover">
      {variants.map((v) => <Button variant={v} className="is-hover">送る</Button>)}
    </StateRow>
    <StateRow label="押した時">
      {variants.map((v) => <Button variant={v} className="is-active">送る</Button>)}
    </StateRow>
  </Fragment>
</ComponentPage>
