---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { TrendToggle, TrendStates } from "../../demos/admin.tsx";
const html = `<p class="muted">推移のグラフは SVG を React が描く(幅を測って軸と棒を置く)。素の HTML で出すときは、<code>packages/react</code> の <code>TrendChart</code> を 1 つだけ読み込むか、下のクラスで SVG を書く。</p>`;
---
<ComponentPage
  title="推移のグラフ(TrendChart)"
  lead="日ごとの使用量を 30 日分、棒か折れ線で出す。棒は灰色で、選んだ 1 本(初めは今日)だけ主の色。押すとその日の値と部署ごとの内訳が出る。数の無い日は棒を置かず「記録なし」と出す。依存は足さず、SVG を自前で描く。"
  props={[
    ["data", "TrendPoint[]", "-", "{ key, label, detail?, value (null は記録なし), breakdown? }"],
    ["type", '"bar" | "line"', '"bar"', "棒か折れ線"],
    ["unit", "string", "-", "単位。値の横に出す"],
    ["height", "number", "200", "軸の高さ(px)"],
    ["selectedKey / defaultSelectedKey / onSelect", "string / (key) => void", "最後の点", "選んだ点。押す、矢印、前の日と次の日のボタンで変わる"],
    ["reference", "{ value, label }", "-", "基準の線(枠の目安など)。直接ラベルを付ける"],
    ["ariaLabel", "string", "-", "グラフの名前(読み上げ)。必須"],
    ["state", '"ready" | "loading" | "empty"', '"ready"', "読み込み中、データ無し"],
    ["breakdownTitle", "string", '"内訳"', "内訳の見出しの語"],
  ]}
  attrs={[[".ki-chart[data-state]", "グラフの枠。loading、empty"], [".ki-chart__readout、__plot、__svg、__col[data-selected]、__bar、__line、__dot、__none、__ref", "読み出し、描画、1 列、棒、線、点、記録なしの印、基準線"], [".ki-chart__break", "部署ごとの内訳(ラベルと棒と値)"]]}
  vars={[["--color-line / --color-line-strong", "格子の線 / 棒(隣の面と 3:1 以上)"], ["--color-primary", "選んだ棒と点(今いる所)"], ["--color-text-muted", "軸の字、折れ線"], ["--color-warn", "基準の線"], ["--font-mono", "軸の数、値"]]}
  html={html}
  overrideNote="グラフの色は役割のトークンだけで決まる。アプリが主の色を変えると、選んだ棒の色が変わる。"
>
  <Fragment slot="demo"><TrendToggle client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" note="データが無い。"><TrendStates kind="empty" client:load /></StateRow>
    <StateRow label="読み込み" note="枠は破線。動かさない。"><TrendStates kind="loading" client:load /></StateRow>
    <StateRow label="失敗" note="失敗はグラフの中に出さず、ホームでは帯(Banner)を上に出す。数の古さは数のカードの印で出す。" />
    <StateRow label="記録なし" note="9/30 は数が無い。棒を置かず、短い線を置いて「記録なし」と出す。"><TrendStates kind="none" client:load /></StateRow>
    <StateRow label="基準の線" note="上限などの線に、直接ラベルを付ける。凡例は使わない。"><TrendStates kind="ref" client:load /></StateRow>
    <StateRow label="無効" na="グラフは無効にしない。データが無ければ空の状態にする" />
    <StateRow label="focus" note="列に Tab で入り、矢印で前後、Home と End で端へ移る。選ぶ列に輪が出る。"><TrendStates kind="focus" client:load /></StateRow>
    <StateRow label="hover" note="灰色の棒が 1 段濃くなる。" />
    <StateRow label="押した時" note="その日が選ばれ、値と内訳が変わる。" />
  </Fragment>
</ComponentPage>
