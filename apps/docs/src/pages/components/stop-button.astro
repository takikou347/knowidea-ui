---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Stops, StopFixed } from "../../demos/admin.tsx";
import { ic } from "../../lib/html.mjs";
const html = `<div class="ki-stop">
  <button type="button" class="ki-button ki-stop__btn" data-variant="secondary" aria-label="制作を止める">${ic("stop")}<span>止める</span></button>
</div>
<div class="ki-stop"><p class="ki-stop__state" role="status"><span class="ki-spinner" aria-hidden="true"></span>依頼中(写しに載るまで待つ)</p></div>
<div class="ki-stop"><span class="ki-status">${ic("stopped")}止めた</span></div>`;
---
<ComponentPage
  title="止めるボタン(StopButton)"
  lead="routine ごとに置く。押すと確かめる画面(ConfirmDialog)が出て、「止める依頼を出す」でもう一度押すと依頼が出る。押した後は「依頼中」、会社の写し(control.json)に載ると「止めた」に変わる。届かなければ、チャットへ貼る文面を写せる。急ぎなので、まとめて送るトレイを通らず 1 件で送る。"
  props={[
    ["name", "string", "-", "止める物の名前(routine の name)"],
    ["state", '"idle" | "requested" | "stopped" | "failed"', '"idle"', "押せる、依頼中、止めた、届かなかった"],
    ["onConfirm", "() => void", "-", "確かめる画面で「止める依頼を出す」を押した(failed の「もう一度」にも使う)"],
    ["onResume", "() => void", "-", "止めたの横の「再開」(任意)"],
    ["fallbackText", "string", "-", "届かなかったとき、チャットへ貼る文面"],
    ["disabled", "boolean", "false", "押せない"],
  ]}
  attrs={[[".ki-stop、__btn、__state、__fail、__fail-actions", "止めるボタンの枠と、依頼中、届かなかったときの面"], ["ConfirmDialog", "確かめる画面は Dialog のページの確かめる形(初めの focus は取り消し側、Esc で閉じる)"]]}
  vars={[["--color-error", "止めるアイコン、届かなかった面"], ["--color-text-muted", "依頼中"], ["--size-hit", "押せる所(44px)"]]}
  html={html}
  htmlNote="確かめる画面は dialog 要素で出す(Dialog のページ)。"
>
  <Fragment slot="demo"><Stops client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="止める物が無いときはボタンを出さない" />
    <StateRow label="押せる" note="止めるアイコンだけが失敗の色。ボタンは中立(危険を主張しない)。"><StopFixed state="idle" client:load /></StateRow>
    <StateRow label="読み込み" note="依頼中。回転と字。"><StopFixed state="requested" client:load /></StateRow>
    <StateRow label="止めた" note="印と字。再開を押せる。"><StopFixed state="stopped" client:load /></StateRow>
    <StateRow label="失敗" note="届かなかった。文面を写せる。"><StopFixed state="failed" client:load /></StateRow>
    <StateRow label="無効" note="押せない。"><StopFixed state="disabled" client:load /></StateRow>
    <StateRow label="focus" note="ボタンに輪。確かめる画面が出たら、初めの focus は「やめる」。" />
    <StateRow label="hover / 押した時" note="ボタンのページと同じ。" />
  </Fragment>
</ComponentPage>
