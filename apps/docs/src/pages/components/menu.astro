---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { MenuDemo, IconMenuDemo } from "../../demos/overlay.tsx";
const html = `<div class="ki-menu__popup" role="menu" aria-label="操作" style="position: static; display: inline-block;">
  <div class="ki-menu__item" role="menuitem" tabindex="-1">名前を変える</div>
  <div class="ki-menu__item" role="menuitem" tabindex="-1">複製する</div>
  <hr class="ki-menu__separator" />
  <div class="ki-menu__item" role="menuitem" tabindex="-1" data-tone="danger">削除する</div>
</div>`;
---
<ComponentPage
  title="メニュー"
  lead="1 つのボタンから、関連する操作の一覧を開く。矢印キーで移り、Esc で閉じ、閉じたらボタンへ戻る。危ない操作は区切りの下に置き、data-tone で色を変える。ナビゲーションには使わない。"
  props={[
    ["trigger", "ReactElement", "-", "開くボタン。1 つの要素"],
    ["items", "MenuEntry[]", "-", "{ label, icon?, tone?, disabled?, onSelect?, href? }、{ type: \"separator\" }、{ type: \"label\", label }"],
    ["align", '"start" | "center" | "end"', '"start"', "ボタンのどこに揃えるか"],
  ]}
  attrs={[[".ki-menu__popup、__item、__separator、__label", "Base UI の Popup と Item に当てる。素の HTML は見た目だけ(開閉の動きは持たない)"], ['[data-tone="danger"]', "危ない操作"], ["[data-highlighted]", "矢印で選んでいる項目"], ["[data-disabled]", "無効の項目"]]}
  vars={[["--color-surface、--color-line、--color-surface-2", "面、枠、選んでいる項目"], ["--color-error", "危ない操作"], ["--shadow-pop", "影(ポップする物)"], ["--size-hit", "項目の高さ"], ["--radius-2、--radius-3", "項目と全体の角丸"]]}
  html={html}
  htmlNote="素の HTML では見た目だけ。開閉と矢印キーの動きが要るときは React の Menu を使う。"
>
  <Fragment slot="demo"><MenuDemo client:load /><IconMenuDemo client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="項目の無いメニューは作らない。開くボタンごと隠す" />
    <StateRow label="読み込み" na="項目が読み込み中のときは、ボタンを読み込み中にして開かない" />
    <StateRow label="失敗" na="操作の失敗は、メニューを閉じた後に知らせか帯で示す" />
    <StateRow label="無効"><MenuDemo disabled client:load /></StateRow>
    <StateRow label="focus"><MenuDemo className="is-focus" client:load /></StateRow>
    <StateRow label="hover" na="項目の面が変わる。開いて確かめる" />
    <StateRow label="押した時" na="項目を押すと実行して閉じる" />
  </Fragment>
</ComponentPage>
