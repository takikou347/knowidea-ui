---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Banners, BannerState } from "../../demos/misc.tsx";
const icon = (n) => `<span class="ki-banner__icon"><svg class="ki-icon" aria-hidden="true"><use href="#${n}"/></svg></span>`;
const html = `<div class="ki-banner" data-tone="info">${icon("info")}
  <div class="ki-banner__body"><p class="ki-banner__title">routine を更新した</p><p class="ki-banner__text">次の実行は明日の 3:10。</p></div>
</div>
<div class="ki-banner" data-tone="error" role="alert">${icon("error")}
  <div class="ki-banner__body"><p class="ki-banner__text">PR を作れなかった。</p></div>
</div>`;
---
<ComponentPage
  title="帯(Banner)"
  lead="画面の中に残る知らせ。情報、成功、警告、失敗。色だけに頼らず、アイコンと文で伝える。読み上げに知らせたいとき(後から出る、変わる)だけ live にする。"
  props={[
    ["tone", '"info" | "success" | "warn" | "error"', '"info"', "種類。info は青(--color-info)"],
    ["title", "ReactNode", "-", "表題(任意)。短く"],
    ["children", "ReactNode", "-", "本文。平叙で短く"],
    ["action", "ReactNode", "-", "右に置く操作。1 つ"],
    ["live", "boolean", "false", "true で role を付ける(error は alert、ほかは status)"],
  ]}
  attrs={[[".ki-banner[data-tone]", "帯。info、success、warn、error"], [".ki-banner__icon、__body、__title、__text、__action", "中の部品"]]}
  vars={[["--color-info-soft、--color-success-soft、--color-warn-soft、--color-error-soft", "各種類の面"], ["--color-info、--color-success、--color-warn、--color-error", "アイコン"], ["--color-text", "文字(全部の種類で 4.5:1 以上)"], ["--radius-2、--space-3、--space-4", "角丸、余白"]]}
  html={html}
>
  <Fragment slot="demo"><Banners client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="文の無い帯は作らない。出さない" />
    <StateRow label="読み込み"><div class="w"><BannerState kind="loading" client:load /></div></StateRow>
    <StateRow label="失敗" note={"失敗は tone=\"error\" の帯そのもの。"}><div class="w"><Banners client:load /></div></StateRow>
    <StateRow label="無効" na="帯は押す物でなく、無効にならない。中の操作が無効になる" />
    <StateRow label="focus" note="帯の中の操作(ボタン、リンク)に輪が出る。"><div class="w"><BannerState kind="focus" client:load /></div></StateRow>
    <StateRow label="hover" na="帯は変わらない" />
    <StateRow label="押した時" na="帯は押せない" />
  </Fragment>
</ComponentPage>
<style is:global>.w { width: 100%; }</style>
