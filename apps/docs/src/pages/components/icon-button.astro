---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Row, Large } from "../../demos/icon-button.tsx";
const html = `<button type="button" class="ki-button ki-icon-button" data-variant="quiet" aria-label="閉じる">
  <svg class="ki-icon" viewBox="0 0 256 256" aria-hidden="true"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg>
</button>`;
---
<ComponentPage
  title="アイコンボタン"
  lead="アイコンだけのボタン。名前(label)が必須で、読み上げに使う。意味が伝わりにくいときはツールチップを添える。"
  props={[
    ["label", "string", "-", "読み上げる名前。必須"],
    ["icon", "ReactNode", "-", "アイコン。必須"],
    ["variant", '"primary" | "secondary" | "quiet" | "danger"', '"quiet"', "ボタンと同じ"],
    ["size", '"md" | "lg"', '"md"', "44px と 52px の正方形"],
    ["loading", "boolean", "false", "回転に変わり、押せなくなる"],
    ["disabled", "boolean", "false", "押せない"],
  ]}
  attrs={[
    [".ki-button.ki-icon-button", "2 つのクラスを重ねる。aria-label を付ける"],
    ["data-variant、data-size、data-loading", "ボタンと同じ"],
  ]}
  vars={[
    ["--size-hit", "幅と高さ(44px)"],
    ["--color-*、--radius-2", "ボタンと同じ"],
  ]}
  html={html}
>
  <Fragment slot="demo"><Row client:load /><Large client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="アイコンが無いアイコンボタンは作らない" />
    <StateRow label="読み込み"><Row kind="loading" client:load /></StateRow>
    <StateRow label="失敗" na="ボタン自身は失敗を持たない。結果は近くの帯か知らせで示す" />
    <StateRow label="無効"><Row kind="disabled" client:load /></StateRow>
    <StateRow label="focus"><Row kind="focus" client:load /></StateRow>
    <StateRow label="hover"><Row kind="hover" client:load /></StateRow>
    <StateRow label="押した時"><Row kind="active" client:load /></StateRow>
  </Fragment>
</ComponentPage>
