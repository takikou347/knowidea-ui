---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { DialogDemo, ConfirmDemo, LoadingDialog, ErrorDialog, DisabledTrigger, FocusTrigger } from "../../demos/overlay.tsx";
const html = `<button type="button" class="ki-button" data-variant="secondary" data-ki-dialog-open="d1">開く(素の HTML)</button>
<dialog id="d1" class="ki-dialog" aria-labelledby="d1-t">
  <h2 id="d1-t" class="ki-dialog__title">routine の名前を変える</h2>
  <p class="ki-dialog__description">一覧と記録の表示が変わる。</p>
  <div class="ki-dialog__actions">
    <button type="button" class="ki-button" data-variant="secondary" data-ki-dialog-close>やめる</button>
    <button type="button" class="ki-button" data-ki-dialog-close>保存する</button>
  </div>
</dialog>`;
---
<ComponentPage
  title="ダイアログ"
  lead="今の作業を止めて、1 つのことを頼む。focus は中に閉じ込め、Esc で閉じ、閉じたら開いたボタンへ戻る。取り返しのつかない操作は「確かめる形」(ConfirmDialog)を使い、外を押しても閉じない。"
  props={[
    ["trigger", "ReactElement", "-", "開くボタン。1 つの要素"],
    ["title", "ReactNode", "-", "表題。必須。読み上げの名前になる"],
    ["description", "ReactNode", "-", "説明。1〜2 文"],
    ["actions", "ReactNode", "-", "下の操作。DialogClose を使うと閉じる"],
    ["loading", "boolean", "false", "中身の代わりに回転と文を出す"],
    ["open / defaultOpen / onOpenChange", "boolean", "-", "制御と非制御"],
    ["ConfirmDialog: confirmLabel", "string", "-", "実行する文。「削除する」のように、何をするかを書く。「OK」は使わない"],
    ["ConfirmDialog: tone", '"danger" | "primary"', '"danger"', "取り返しがつかない操作は danger"],
    ["ConfirmDialog: onConfirm", "() => void", "-", "実行"],
  ]}
  attrs={[[".ki-dialog", "素の HTML は <dialog> に付けて showModal() で開く(閉じ込めと Esc はブラウザが持つ)"], [".ki-dialog__title、__description、__actions", "表題、説明、操作"], [".ki-dialog__popup、__backdrop", "Base UI の Popup と Backdrop に当てる"], ["data-ki-dialog-open、data-ki-dialog-close", "enhance.js が開閉する"]]}
  vars={[["--color-surface、--color-line", "面、枠"], ["--shadow-pop", "影(ポップする物)"], ["--color-bg", "背面を覆う膜(70%)"], ["--radius-3、--space-4、--space-5", "角丸、画面との余白(16px)、中の余白"], ["--motion-duration-state", "出入り。reduced-motion で止まる"]]}
  html={html}
  htmlNote="enhance.js を読むと data 属性で開閉できる。"
  overrideNote="ダイアログは body に出るので、上書きは :root かアプリの根に書く。下は開くボタンの見た目。"
>
  <Fragment slot="demo"><DialogDemo client:load /><ConfirmDemo client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="中身の無いダイアログは作らない" />
    <StateRow label="読み込み"><LoadingDialog client:load /></StateRow>
    <StateRow label="失敗"><ErrorDialog client:load /></StateRow>
    <StateRow label="無効"><DisabledTrigger client:load /></StateRow>
    <StateRow label="focus" note="開くと初めの要素に focus が入る。確かめる形は取り消し側が先。"><FocusTrigger client:load /></StateRow>
    <StateRow label="hover" na="ダイアログ自体は変わらない。中のボタンが変わる" />
    <StateRow label="押した時" na="開く操作は押すと開く。確かめる形は「やめる」と「削除する」で閉じる" />
  </Fragment>
</ComponentPage>
