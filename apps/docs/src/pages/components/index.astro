---
import Base from "../../layouts/Base.astro";
import { categories, components } from "../../lib/registry.mjs";
import { links } from "../../lib/paths.mjs";
const { href } = links(Astro.url.pathname);
---
<Base title="Components" description="コンポーネントの一覧" toc={false}>
  <h1>Components</h1>
  <p class="lead">{components.length} 個のコンポーネントを、{categories.length} つのカテゴリに分けている。どのアプリにも属さない汎用のコンポーネントで、名前は上部の検索でも探せる。</p>
  {categories.map((cat) => (
    <>
      <h2 id={cat.id}>{cat.name}</h2>
      <div class="table-wrap">
        <table class="docs-table link-table">
          <thead><tr><th>Name</th><th>Description</th></tr></thead>
          <tbody>
            {components.filter((c) => c.cat === cat.id).map((c) => (
              <tr>
                <td><a href={href("components/" + c.slug)}><code>{c.name}</code></a></td>
                <td>{(c.lead ?? "").split("。")[0]}。</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  ))}
</Base>
