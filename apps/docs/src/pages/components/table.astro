---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Demo, State } from "../../demos/table.tsx";
const html = `<div class="ki-table-wrap" role="region" aria-label="routine の一覧" tabindex="0">
  <table class="ki-table">
    <thead><tr>
      <th scope="col" aria-sort="ascending"><button type="button" class="ki-table__sort">routine</button></th>
      <th scope="col" data-numeric>実行</th>
      <th scope="col" data-numeric>使用量のトークン</th>
    </tr></thead>
    <tbody>
      <tr><td>review</td><td data-numeric>24</td><td data-numeric>182,400</td></tr>
      <tr aria-selected="true"><td>production</td><td data-numeric>7</td><td data-numeric>96,250</td></tr>
    </tbody>
  </table>
</div>`;
---
<ComponentPage
  title="表"
  lead="行と列で比べる。数字の列は等幅で右寄せにする。狭い幅では表の中だけが横に動く(ページは動かさない)。並べ替えは見出しのボタンで、aria-sort が付く。"
  props={[
    ["label", "string", "-", "表の名前。必須。横に動く領域の名前にもなる"],
    ["columns", "Column[]", "-", "key、header、numeric、sortable、wrap、render"],
    ["rows / rowKey", "T[] / (row) => string", "-", "行と、行ごとの一意のキー"],
    ["sort / onSortChange", "{ key, direction } | null", "-", "並べ替え。見出しを押すと 昇順、降順、なし の順に回る。並べ替える処理は呼ぶ側"],
    ["selectable / selected / onSelectedChange", "boolean / string[] / fn", "false", "行の選択。見出しのチェックで全選択"],
    ["loading", "boolean", "false", "仮の行を 3 つ出す。aria-busy"],
    ["error / onRetry", "ReactNode / () => void", "-", "失敗の帯と「もう一度」"],
    ["emptyTitle / emptyText / emptyAction", "-", "-", "行が 0 のときの空の状態"],
  ]}
  attrs={[[".ki-table-wrap > table.ki-table", "外の枠が横に動く。tabindex=\"0\" と role=\"region\" と aria-label を付ける"], ["th[aria-sort]、.ki-table__sort", "並べ替えの見出し"], ["td[data-numeric]、th[data-numeric]", "数字。右寄せ、等幅"], ["tr[aria-selected=\"true\"]", "選んだ行。左に 2px の主の色"], ["[data-select]", "選択のチェックの列"]]}
  vars={[["--color-surface、--color-surface-2、--color-line", "面、見出し、行の線"], ["--color-primary", "選んだ行の印"], ["--font-mono、--font-size-2", "数字、表の文字"], ["--space-2、--space-3、--size-hit", "余白、見出しのボタンの高さ"]]}
  html={html}
  htmlNote="並べ替えと選択の動きは自分で書く(React の Table が持つ)。"
>
  <Fragment slot="demo"><Demo client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空"><State kind="empty" client:load /></StateRow>
    <StateRow label="読み込み"><State kind="loading" client:load /></StateRow>
    <StateRow label="失敗"><State kind="error" client:load /></StateRow>
    <StateRow label="無効" note="選択のチェックは、全選択を含め、読み込み中と行が無いとき無効になる。"><State kind="disabled" client:load /></StateRow>
    <StateRow label="focus" note="表の枠(横に動く領域)と、並べ替えのボタンに輪が出る。Tab で回る。"><State kind="focus" client:load /></StateRow>
    <StateRow label="hover" na="行の hover は面が変わるだけ。実機で触れて確かめる" />
    <StateRow label="押した時" na="並べ替えと選択は押すと変わる。押している間の見た目は無い" />
  </Fragment>
</ComponentPage>
