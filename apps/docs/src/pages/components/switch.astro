---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Switch } from "@knowidea/react";
const html = `<label class="ki-choice"><input type="checkbox" role="switch" class="ki-switch" checked /><span>routine を動かす</span></label>`;
---
<ComponentPage
  title="スイッチ"
  lead="押してすぐに効く入と切。フォームで「保存」を押してから効くものはチェックを使う。ラベルは状態でなく対象を書く(「動かす」であって「オン」ではない)。"
  props={[
    ["label", "ReactNode", "-", "ラベル。対象を書く"],
    ["checked / defaultChecked / onCheckedChange", "boolean", "-", "制御と非制御"],
    ["loading", "boolean", "false", "効くまで待つ間。操作できず、回転を出す"],
    ["disabled", "boolean", "false", "押せない"],
  ]}
  attrs={[[".ki-choice > .ki-switch", "素の HTML は <input type=\"checkbox\" role=\"switch\">"], ["[data-checked]、:checked", "入"]]}
  vars={[["--color-primary", "入の面"], ["--color-line-strong、--color-surface", "切の面と丸"], ["--space-5、--space-6、--space-2", "大きさ(24px、40px)"], ["--motion-duration-state", "丸の動き。reduced-motion で止まる"]]}
  html={html}
>
  <Fragment slot="demo"><Switch client:load label="routine を動かす" defaultChecked /><Switch client:load label="通知する" /></Fragment>
  <Fragment slot="states">
    <StateRow label="空"><Switch client:load label="切" /><Switch client:load label="入" defaultChecked /></StateRow>
    <StateRow label="読み込み"><Switch client:load label="反映中" loading defaultChecked /></StateRow>
    <StateRow label="失敗" na="反映できなかったときは元に戻し、近くの帯か知らせで理由を示す" />
    <StateRow label="無効"><Switch client:load label="切" disabled /><Switch client:load label="入" disabled defaultChecked /></StateRow>
    <StateRow label="focus"><Switch client:load label="切" className="is-focus" /></StateRow>
    <StateRow label="hover"><Switch client:load label="切" className="is-hover" /></StateRow>
    <StateRow label="押した時" na="押すと入と切が変わる。押している間の見た目は無い" />
  </Fragment>
</ComponentPage>
