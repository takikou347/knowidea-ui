---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Activities } from "../../demos/admin.tsx";
import { ic } from "../../lib/html.mjs";
const html = `<ul class="ki-activity">
  <li class="ki-activity__item" data-kind="merge">
    <span class="ki-activity__icon">${ic("merge")}</span>
    <div class="ki-activity__body">
      <p class="ki-activity__text"><span class="ki-activity__kind">マージ</span> <a href="#">develop-docs #130 をマージした</a></p>
      <p class="ki-activity__meta"><span>レビュー部</span><time>10/13 09:28</time></p>
    </div>
  </li>
</ul>`;
---
<ComponentPage
  title="最近の動きの一覧(ActivityList)"
  lead="マージ、公開、記録、止めたことが新しい順に並ぶ(20 件まで)。各行は種類(アイコンと字)、1 行の中身(リンク)、Claude の役、日本時間の時刻。"
  props={[
    ["items", "ActivityItem[]", "-", "{ id, time, role, kind (merge、publish、record、stop), text, href? }"],
    ["state", '"ready" | "loading" | "empty" | "error"', '"ready"', "一覧の状態"],
    ["emptyText / errorText", "string", "-", "空と失敗の文"],
  ]}
  attrs={[[".ki-activity、__item[data-kind]、__icon、__body、__text、__kind、__meta", "一覧と行。区切りは行の下の線だけ"]]}
  vars={[["--color-success", "マージの印"], ["--color-error", "止めたの印"], ["--color-text-muted", "役と時刻、他の印"], ["--color-line", "行の区切り"]]}
  html={html}
>
  <Fragment slot="demo"><Activities client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" note="空の状態(EmptyState)。"><Activities state="empty" client:load /></StateRow>
    <StateRow label="読み込み" note="スケルトン。"><Activities state="loading" client:load /></StateRow>
    <StateRow label="失敗" note="失敗の文。"><Activities state="error" client:load /></StateRow>
    <StateRow label="無効" na="行は操作しない。中のリンクだけ" />
    <StateRow label="focus" note="リンクに輪が出る。" />
    <StateRow label="hover" note="リンクの下線。" />
    <StateRow label="押した時" note="リンク先(GitHub、記録)を開く。" />
  </Fragment>
</ComponentPage>
