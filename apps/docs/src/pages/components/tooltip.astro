---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { TooltipDemo } from "../../demos/overlay.tsx";
const html = `<span class="ki-tooltip-wrap">
  <button type="button" class="ki-button" data-variant="secondary" aria-describedby="tt1">使用量</button>
  <span id="tt1" role="tooltip" class="ki-tooltip">日本時間の 0 時で区切る</span>
</span>`;
---
<ComponentPage
  title="ツールチップ"
  lead="触れた要素の補足を短く出す。hover と focus で開き、Esc で閉じる。押せるものや大事な文は入れない(タッチでは出ないため)。アイコンだけのボタンの名前は aria-label で付け、ツールチップは補足にする。"
  props={[
    ["content", "ReactNode", "-", "補足の文。短く"],
    ["children", "ReactElement", "-", "触れる要素 1 つ"],
    ["side", '"top" | "bottom" | "left" | "right"', '"top"', "出る側"],
  ]}
  attrs={[[".ki-tooltip", "吹き出し。Base UI の Popup に当てる"], [".ki-tooltip-wrap", "素の HTML。hover と focus-within で出す。Esc では閉じない(React を使うと閉じる)"]]}
  vars={[["--color-surface、--color-line、--color-text", "面、枠、文字"], ["--shadow-pop", "影(ポップする物)"], ["--radius-2、--space-1、--space-3", "角丸、余白"]]}
  html={html}
  htmlNote="素の HTML は触れると出るだけ。"
>
  <Fragment slot="demo"><TooltipDemo client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="文の無いツールチップは出さない" />
    <StateRow label="読み込み" na="該当しない。読み込み中の補足は、要素の近くの文で書く" />
    <StateRow label="失敗" na="該当しない。失敗はツールチップに入れない(読めない人がいる)" />
    <StateRow label="無効" na="無効のボタンには focus が入らず出ない。理由はボタンの近くの文で書く" />
    <StateRow label="focus" note="Tab で触れる要素に focus すると出る(デモで確かめる)。" ><TooltipDemo client:load /></StateRow>
    <StateRow label="hover" note="触れると出る。"><span class="ki-tooltip-wrap is-open" style="margin-top: 44px"><button type="button" class="ki-button" data-variant="secondary">使用量</button><span role="tooltip" class="ki-tooltip">日本時間の 0 時で区切る</span></span></StateRow>
    <StateRow label="押した時" na="押しても変わらない" />
  </Fragment>
</ComponentPage>
