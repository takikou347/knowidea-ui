---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Spinners } from "../../demos/misc.tsx";
const html = `<span class="ki-spinner" aria-hidden="true"></span>
<span class="ki-sr-only" role="status">読み込み中</span>`;
---
<ComponentPage
  title="読み込み(回転)"
  lead="小さな回転。ボタンや入力の中で、短い待ちを示す。大きさは周りの文字の大きさ(1em)。reduced-motion では回さず、点線の輪にする。"
  props={[["label", "string", "-", "読み上げる文。無ければ装飾"], ["className", "string", "-", "追加のクラス"]]}
  attrs={[[".ki-spinner", "回転。大きさは font-size で変える"]]}
  vars={[["currentColor", "色は周りの文字の色"]]}
  html={html}
  htmlNote="読み上げには ki-sr-only の文を足す。"
>
  <Fragment slot="demo"><Spinners client:load /></Fragment>
  <Fragment slot="states">
    <StateRow label="空" na="該当しない" />
    <StateRow label="読み込み">この部品そのもの。</StateRow>
    <StateRow label="失敗" na="失敗したら回転を消し、帯か誤りを出す" />
    <StateRow label="無効" na="該当しない" />
    <StateRow label="focus" na="該当しない。focus を受けない" />
    <StateRow label="hover" na="該当しない" />
    <StateRow label="押した時" na="該当しない" />
  </Fragment>
</ComponentPage>
