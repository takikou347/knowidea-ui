---
import ComponentPage from "../../components/ComponentPage.astro";
import StateRow from "../../components/StateRow.astro";
import { Textarea } from "@knowidea/react";
const html = `<textarea class="ki-textarea" rows="3" aria-label="メモ" placeholder="メモを書く"></textarea>`;
---
<ComponentPage
  title="複数行の入力"
  lead="複数行の文字を受ける。縦にだけ大きさを変えられる。"
  props={[
    ["invalid", "boolean", "false", "失敗の枠と aria-invalid"],
    ["rows", "number", "3", "初めの行数"],
    ["...textarea", "-", "-", "value、onChange、disabled など"],
  ]}
  attrs={[[".ki-textarea", "<textarea> に付ける"], ['aria-invalid="true"', "失敗"]]}
  vars={[["--color-surface、--color-line-strong、--color-error、--color-focus", "面、枠、失敗、focus"], ["--size-hit、--space-2、--space-3、--radius-2", "最小の高さ(2 倍)、余白、角丸"]]}
  html={html}
>
  <Fragment slot="demo"><div class="w"><Textarea client:load aria-label="メモ" placeholder="メモを書く" /></div></Fragment>
  <Fragment slot="states">
    <StateRow label="空"><div class="w"><Textarea client:load aria-label="空" placeholder="メモを書く" /></div></StateRow>
    <StateRow label="読み込み" na="読み込み中は欄の外に回転と文を出し、入力は readOnly にする" />
    <StateRow label="失敗"><div class="w"><Textarea client:load aria-label="失敗" defaultValue="短すぎる" invalid /></div></StateRow>
    <StateRow label="無効"><div class="w"><Textarea client:load aria-label="無効" defaultValue="メモ" disabled /></div></StateRow>
    <StateRow label="focus"><div class="w"><Textarea client:load aria-label="focus" defaultValue="メモ" className="is-focus" /></div></StateRow>
    <StateRow label="hover"><div class="w"><Textarea client:load aria-label="hover" defaultValue="メモ" className="is-hover" /></div></StateRow>
    <StateRow label="押した時" na="入力中は focus と同じ" />
  </Fragment>
</ComponentPage>
<style is:global>.w { width: min(100%, 320px); }</style>
