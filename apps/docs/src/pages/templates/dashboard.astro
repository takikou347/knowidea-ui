---
import Base from "../../layouts/Base.astro";
import Code from "../../components/Code.astro";
import Dashboard from "../../templates/Dashboard.tsx";
import { links } from "../../lib/paths.mjs";
const { href } = links(Astro.url.pathname);
const use = `<Shell title="ダッシュボード" current="home" actions={<IconButton label="更新" icon={<Icon name="refresh" />} />}>
  <Alert tone="info">この画面の数は全部、見本の数。実際の値ではない。</Alert>
  <Grid minItemWidth={170}>
    <Stat label="件数" icon="list" value={1280} unit="件" delta={{ dir: "up", text: "+12%" }} />
    ...
  </Grid>
  <Card title="日ごとの件数" headingLevel={3}><Chart data={days} unit="件" ariaLabel="日ごとの件数" /></Card>
  <Grid minItemWidth={260}>
    <Card title="最近の出来事" headingLevel={3}><Timeline items={events} /></Card>
    <Card title="確認待ち" headingLevel={3}><List label="確認待ちの項目" items={waiting} /></Card>
  </Grid>
</Shell>`;
---
<Base title="ダッシュボード" description="数、推移、出来事、待ちを 1 画面に並べる見本">
  <h1>ダッシュボード</h1>
  <p class="lead">Stat、Chart、Timeline、List を Card に載せて並べた画面。特定のアプリではなく、部品の組み合わせの見本。</p>
  <p>画面の骨組み(<code>Shell</code>)は、このサイト用の小さな部品。枠の幅が 720px 以上なら左に <a href={href("components/drawer")}>Drawer</a>、それより狭ければ上の <a href={href("components/app-bar")}>AppBar</a> から開く Drawer と、下の <a href={href("components/bottom-navigation")}>BottomNavigation</a> に切り替わる。</p>
  <p class="muted">数は全部、見本の数。実際の値ではない。</p>
  <Dashboard client:load />
  <h2 id="parts">使っている部品</h2>
  <ul class="plain">
    <li>上のバーと目次: AppBar、Drawer、BottomNavigation</li>
    <li>数: <a href={href("components/stat")}>Stat</a>(差と推移の線つき)</li>
    <li>推移: <a href={href("components/chart")}>Chart</a>(押すと内訳。矢印キーで点を移る)</li>
    <li>面: <a href={href("components/card")}>Card</a>、並べ方: <a href={href("components/grid")}>Grid</a></li>
    <li>出来事と待ち: <a href={href("components/timeline")}>Timeline</a>、<a href={href("components/list")}>List</a></li>
  </ul>
  <h2 id="code">組み方</h2>
  <Code code={use} label="ダッシュボードの組み方" />
</Base>
