---
import Base from "../../layouts/Base.astro";
import Code from "../../components/Code.astro";
import Dashboard from "../../templates/Dashboard.tsx";
import { links } from "../../lib/paths.mjs";
const { href } = links(Astro.url.pathname);
const use = `<Shell title="ダッシュボード" current="home" actions={<IconButton label="更新" icon={<Icon name="refresh" />} />}>
  <Alert tone="info">この画面の数値はすべてサンプルであり、実際の値ではない。</Alert>
  <Grid minItemWidth={170}>
    <Stat label="件数" icon="list" value={1280} unit="件" delta={{ dir: "up", text: "+12%" }} />
    ...
  </Grid>
  <Card title="日ごとの件数(サンプル値)" headingLevel={3}><Chart data={days} unit="件" ariaLabel="日ごとの件数(サンプル値)" /></Card>
  <Grid minItemWidth={260}>
    <Card title="最近のイベント" headingLevel={3}><Timeline items={events} /></Card>
    <Card title="確認待ち" headingLevel={3}><List label="確認待ちの項目" items={waiting} /></Card>
  </Grid>
</Shell>`;
---
<Base title="Dashboard" description="数値、推移、イベント、待ち状態を 1 画面に並べたサンプル">
  <h1>Dashboard</h1>
  <p class="lead">Stat、Chart、Timeline、List を Card に載せて並べた画面。特定のアプリではなく、コンポーネントの組み合わせのサンプル。</p>
  <p>画面の骨組み(<code>Shell</code>)は、このサイト用の小さなコンポーネント。コンテナの幅が 720px 以上なら左に <a href={href("components/drawer")}>Drawer</a> を置き、それより狭ければ、上部の <a href={href("components/app-bar")}>AppBar</a> から開く Drawer と、下部の <a href={href("components/bottom-navigation")}>BottomNavigation</a> に切り替わる。</p>
  <p class="muted">数値はすべてサンプルであり、実際の値ではない。</p>
  <Dashboard client:load />
  <h2 id="parts">Components used</h2>
  <ul class="plain">
    <li>上部のバーとナビゲーション: AppBar、Drawer、BottomNavigation</li>
    <li>数値: <a href={href("components/stat")}>Stat</a>(前回との差と推移の折れ線つき)</li>
    <li>推移: <a href={href("components/chart")}>Chart</a>(クリックすると内訳を表示。矢印キーで点を移動)</li>
    <li>背景の枠: <a href={href("components/card")}>Card</a>、レイアウト: <a href={href("components/grid")}>Grid</a></li>
    <li>イベントと待ち状態: <a href={href("components/timeline")}>Timeline</a>、<a href={href("components/list")}>List</a></li>
  </ul>
  <h2 id="code">Composition</h2>
  <Code code={use} label="Dashboard composition" />
</Base>
