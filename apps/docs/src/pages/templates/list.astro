---
import Base from "../../layouts/Base.astro";
import Code from "../../components/Code.astro";
import ListScreen from "../../templates/ListScreen.tsx";
import { links } from "../../lib/paths.mjs";
const { href } = links(Astro.url.pathname);
const use = `const chosen = sel.filter((id) => shown.some((r) => r.id === id));

<Chip label="処理中 2" selected={filter === "working"} onClick={...} />
<SelectionBar
  count={chosen.length}
  onClear={() => setSel([])}
  actions={<Button variant="secondary" disabled={chosen.length === 0} onClick={archive}>アーカイブする</Button>}
/>
<List label="項目の一覧" items={items} selected={chosen} onSelectedChange={setSel}
      state={loading ? "loading" : shown.length === 0 ? "empty" : "ready"} />`;
---
<Base title="List" description="行を選択して、まとめて操作するサンプル">
  <h1>List</h1>
  <p class="lead">状態で絞り込み、行を選択して、まとめて操作する。操作のあとは結果を通知し、アーカイブは元に戻せる。</p>
  <p class="muted">項目はすべてサンプル。操作はこの画面の中だけで動き、どこにも送信しない。</p>
  <ListScreen client:load />
  <h2 id="flow">Try it</h2>
  <ul class="plain">
    <li>行の左端のチェックボックスで選択する。選択すると、上部の <a href={href("components/selection-bar")}>SelectionBar</a> に件数と操作が表示される</li>
    <li>「アーカイブする」は行を一覧から外し、「元に戻す」で戻せる。「完了にする」は状態を変更する</li>
    <li>上部の「再読み込み」を押すと、ローディング中の表示になる。絞り込みの結果が 0 件なら、空の表示になる</li>
    <li>キューに追加してまとめて送信する形は、<a href={href("components/list")}>List</a> のページの例を参照</li>
  </ul>
  <h2 id="code">Composition</h2>
  <Code code={use} label="List screen composition" />
</Base>
