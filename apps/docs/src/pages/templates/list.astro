---
import Base from "../../layouts/Base.astro";
import Code from "../../components/Code.astro";
import ListScreen from "../../templates/ListScreen.tsx";
import { links } from "../../lib/paths.mjs";
const { href } = links(Astro.url.pathname);
const use = `const chosen = sel.filter((id) => shown.some((r) => r.id === id));

<Chip label="処理中 2" selected={filter === "working"} onClick={...} />
<SelectionBar
  count={chosen.length}
  onClear={() => setSel([])}
  actions={<Button variant="secondary" disabled={chosen.length === 0} onClick={archive}>保管する</Button>}
/>
<List label="項目の一覧" items={items} selected={chosen} onSelectedChange={setSel}
      state={loading ? "loading" : shown.length === 0 ? "empty" : "ready"} />`;
---
<Base title="一覧と一括の操作" description="行を選び、まとめて操作する見本">
  <h1>一覧と一括の操作</h1>
  <p class="lead">状態で絞り、行を選び、まとめて操作する。操作のあとは結果を知らせ、保管は元に戻せる。</p>
  <p class="muted">項目は全部、見本。操作はこの画面の中だけで動き、どこにも送らない。</p>
  <ListScreen client:load />
  <h2 id="flow">触ってみる</h2>
  <ul class="plain">
    <li>行の左の枠を押して選ぶ。選ぶと上の <a href={href("components/selection-bar")}>SelectionBar</a> に件数と操作が出る</li>
    <li>「保管する」は行を外し、「元に戻す」で戻る。「完了にする」は状態を変える</li>
    <li>上の「読み込み直す」を押すと、読み込み中の見え方になる。絞った結果が 0 件なら空の見え方になる</li>
    <li>貯めて送る形は、<a href={href("components/list")}>List</a> のページの例を見る</li>
  </ul>
  <h2 id="code">組み方</h2>
  <Code code={use} label="一覧と一括の操作の組み方" />
</Base>
