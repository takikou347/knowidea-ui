---
import Base from "../layouts/Base.astro";
import HomeLive from "../components/HomeLive.tsx";
import { CodeBlock } from "@knowidea/ui";
import { links } from "../lib/paths.mjs";
import { components, categories } from "../lib/registry.mjs";
import { pick, tileCode } from "../lib/tiles.mjs";
import ui from "@knowidea/ui/package.json";
import all from "@knowidea/icons/dist/icons-data.json" with { type: "json" };
const { href, rel } = links(Astro.url.pathname);
const icon = (n) => `<svg class="ki-icon" aria-hidden="true"><use href="${rel}sprite.svg#${n}"/></svg>`;

// 動く部品の格子に置くもの。どれもデモのページと同じ部品
const picks = [
  ["button", "Variants"], ["text-field", "Basic"], ["select", "Basic"], ["checkbox", "Basic"], ["switch", "Basic"], ["radio", "Basic"],
  ["chip", "Filter"], ["badge", "Tones"], ["tabs", "Basic"], ["accordion", "Basic"], ["progress", "Basic"], ["alert", "Closable"],
  ["pagination", "Basic"], ["menu", "Basic"], ["dialog", "Basic"], ["tooltip", "Basic"], ["breadcrumbs", "Basic"], ["avatar", "Sizes"],
];
const raws = import.meta.glob("../demos/*.tsx", { query: "?raw", import: "default", eager: true });
const cells = picks.map(([slug, fn]) => {
  const c = components.find((x) => x.slug === slug);
  const t = tileCode(c, raws[`../demos/${slug}.tsx`], fn);
  return { slug, fn, name: c.name, href: href("components/" + slug), react: t.react, html: t.html };
});
const features = [
  { icon: "settings", title: "Theming", text: "プライマリカラー、角丸、密度、字の大きさを createTheme で変える。変わるのは CSS 変数だけで、コンポーネントのコードには触らない。", to: "customization/theme", link: "Theme" },
  { icon: "eye", title: "Accessibility", text: "押せる所は 44px 以上。focus の輪は 2px で、本文のコントラスト比は 4.5:1 以上。キーボード操作は Base UI に任せている。", to: "components", link: "Components" },
  { icon: "moon", title: "Dark mode", text: "ライトを反転せず、ダークは別に決めた値を持つ。OS の設定にも、data-theme にも従う。", to: "customization/dark-mode", link: "Dark mode" },
  { icon: "star", title: "Icons", text: `${all.icons.length} 個のアイコンを regular と bold で用意している。SVG、sprite、React のコンポーネントから使える。`, to: "icons", link: "Icons" },
];
---
<Base title="KNOW IDEA UI" description="Base UI を土台にした React のコンポーネントと、色、角丸、密度を変えられるトークン。特定のアプリに依存しない。" home toc={false}>
  <div class="home-in">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-text">
        <h1 id="hero-title">React components for dense, themeable interfaces</h1>
        <p class="hero-lead">Base UI を土台にした {components.length} 個のコンポーネントと、色、角丸、密度を変えられるトークン。特定のアプリに依存しない。</p>
        <div class="hero-actions">
          <a class="ki-button" href={href("getting-started/install")}>Get started</a>
          <a class="ki-button" data-variant="secondary" href={href("components")}>Browse components</a>
        </div>
      </div>
      <div class="hero-side">
        <CodeBlock client:load language="bash" code="pnpm add ./vendor/knowidea-*.tgz" label="Install" />
        <p class="hero-note">外部の公開先にはまだ出していない。tarball で配る(<a href={href("getting-started/install")}>Installation</a>)。現在の版は <span class="num">v{ui.version}</span>。</p>
      </div>
    </section>

    <section class="live" aria-labelledby="live-title">
      <h2 id="live-title">Live components</h2>
      <p class="live-lead">色、角丸、密度、ダークを切り替えると、下の画面と部品がその場で変わる。部品はどれも本物で、そのまま操作できる。</p>
      <HomeLive client:load cells={cells} />
    </section>

    <section class="features" aria-labelledby="features-title">
      <h2 id="features-title">Features</h2>
      <ul class="features-grid">
        {features.map((f) => (
          <li>
            <h3><Fragment set:html={icon(f.icon)} />{f.title}</h3>
            <p>{f.text}</p>
            <a href={href(f.to)}>{f.link}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="entry" aria-labelledby="entry-title">
      <h2 id="entry-title">Components</h2>
      <p>{components.length} 個を {categories.length} つのカテゴリに分けている。各部品のページに、デモ、5 つの状態、props、CSS 変数、アクセシビリティの注意がある。</p>
      <ul class="entry-cats">
        {categories.map((c) => <li><a href={href("components") + "#" + c.id}>{c.name}<span class="num">{c.list.length}</span></a></li>)}
      </ul>
      <a class="ki-button" data-variant="secondary" href={href("components")}>Browse components</a>
    </section>
  </div>
</Base>
