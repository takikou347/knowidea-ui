---
import Base from "../layouts/Base.astro";
import HomeLive from "../components/HomeLive.tsx";
import { CodeBlock } from "knowidea-ui";
import { links } from "../lib/paths.mjs";
import { components, categories } from "../lib/registry.mjs";
import { pick, tileCode } from "../lib/tiles.mjs";
import ui from "knowidea-ui/package.json";
import all from "knowidea-icons/dist/icons-data.json" with { type: "json" };
const { href, rel } = links(Astro.url.pathname);
const icon = (n) => `<svg class="ki-icon" aria-hidden="true"><use href="${rel}sprite.svg#${n}"/></svg>`;

// トップの格子に置く代表的な操作。全部の見本とコードは Components と各部品のページにある
const picks = [
  ["button", "Variants"], ["text-field", "Basic"], ["checkbox", "Basic"], ["switch", "Basic"], ["tabs", "Basic"], ["chip", "Filter"],
];
const raws = import.meta.glob("../demos/*.tsx", { query: "?raw", import: "default", eager: true });
const first = (t) => ((t ?? "").split("。")[0] ?? "") + "。";
const cells = picks.map(([slug, fn]) => {
  const c = components.find((x) => x.slug === slug);
  const t = tileCode(c, raws[`../demos/${slug}.tsx`], fn);
  return { slug, fn, name: c.name, desc: first(c.lead), href: href("components/" + slug), react: t.react, html: t.html };
});
// 4 つの特長。言葉で褒めず、上の実物のどこを見ればよいかを示す
const features = [
  { icon: "settings", title: "Theming", text: "上の Primary と Radius を押すと、画面と部品の色と角丸がその場で変わる。変わるのは CSS 変数だけで、コンポーネントのコードには触らない。", at: "#hl-controls", atLabel: "上の画面で試す", to: "customization/theme", link: "Theme" },
  { icon: "eye", title: "Accessibility", text: "Compact でも、押せる所は 44px 以上。focus の輪は 2px で、本文のコントラスト比は 4.5:1 以上。Density を Comfortable にすると余白だけが広がる。", at: "#hl-stage", atLabel: "上の画面で試す", to: "components", link: "Components" },
  { icon: "moon", title: "Dark mode", text: "上の Dark を入れると、反転ではなく別に決めた値に切り替わる。OS の設定にも、data-theme にも従う。", at: "#hl-controls", atLabel: "上の画面で試す", to: "customization/dark-mode", link: "Dark mode" },
  { icon: "star", title: "Icons", text: `上の Stat のアイコンも、${all.icons.length} 個のうちの 1 つ。regular と bold があり、SVG、sprite、React のコンポーネントから使える。`, at: "#hl-stage", atLabel: "上の画面で見る", to: "icons", link: "Icons" },
];
---
<Base title="KNOW IDEA UI" description="Base UI を土台にした React のコンポーネントと、色、角丸、密度を変えられるトークン。特定のアプリに依存しない。" home toc={false}>
  <div class="home-in">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-text">
        <h1 id="hero-title">Dense UI that stays operable</h1>
        <p class="hero-lead">Base UI を土台にした {components.length} 個の React コンポーネント。下の画面は本物の部品で、Compact のまま 44px の操作領域を保つ。</p>
        <div class="hero-actions">
          <a class="ki-button" href={href("getting-started/install")}>Get started</a>
          <a class="ki-button" data-variant="secondary" href={href("components")}>Browse components</a>
        </div>
      </div>
      <div class="hero-side">
        <CodeBlock client:load language="bash" code="npm install knowidea-ui knowidea-css knowidea-tokens knowidea-icons" label="Install" />
        <p class="hero-note">npm で配っている(<a href={href("getting-started/install")}>Installation</a>)。現在の版は <span class="num">v{ui.version}</span>。</p>
      </div>
    </section>

    <section class="live" aria-labelledby="live-title">
      <h2 id="live-title">Live components</h2>
      <p class="live-lead">色、角丸、密度、ダークを切り替えると、画面と部品がその場で変わる。数値はサンプル。</p>
      <HomeLive client:load cells={cells} />
    </section>

    <section class="entry" aria-labelledby="entry-title">
      <h2 id="entry-title">Components</h2>
      <p>この見本は代表だけ。{components.length} 個の全部を {categories.length} つのカテゴリに分けてある。各部品のページに、デモ、5 つの状態、props、CSS 変数、アクセシビリティの注意とコードがある。</p>
      <ul class="entry-cats">
        {categories.map((c) => <li><a href={href("components") + "#" + c.id}>{c.name}<span class="num">{c.list.length}</span></a></li>)}
      </ul>
      <a class="ki-button" data-variant="secondary" href={href("components")}>Browse components</a>
    </section>
    <section class="features" aria-labelledby="features-title">
      <h2 id="features-title">Features</h2>
      <p class="features-lead">それぞれ、上の実物のどこを見ればよいかを書いた。</p>
      <ul class="features-grid">
        {features.map((f) => (
          <li>
            <h3><Fragment set:html={icon(f.icon)} />{f.title}</h3>
            <p>{f.text}</p>
            <p class="features-links"><a href={f.at} aria-label={`${f.title} を${f.atLabel}`}>{f.atLabel}</a><a href={href(f.to)}>{f.link}</a></p>
          </li>
        ))}
      </ul>
    </section>

  </div>
</Base>
