---
import Base from "../../layouts/Base.astro";
import Code from "../../components/Code.astro";
import { links } from "../../lib/paths.mjs";
const { href } = links(Astro.url.pathname);
const css = `@import "tailwindcss";
@import "@knowidea/tokens/theme.css";    /* @theme に色、フォント、余白、角丸を渡す */
@import "@knowidea/tokens/tokens.css";   /* ダークモードの値と、実際の変数 */
@import "@knowidea/css/index.css";       /* コンポーネントの見た目 */`;
const use = `<div class="rounded-2 bg-surface border border-line p-4 text-text">
  <button class="ki-button" data-variant="primary">完了にする</button>
</div>`;
---
<Base title="Tailwind v4" description="トークンを Tailwind のユーティリティとして使う">
  <h1>Tailwind v4</h1>
  <p class="lead">トークンを <code>@theme</code> に渡すため、<code>bg-surface</code> や <code>text-text-muted</code> のようなユーティリティが、同じ CSS 変数を参照する。</p>
  <h2 id="css">CSS</h2>
  <Code code={css} lang="css" label="Tailwind CSS" />
  <h2 id="use">Usage</h2>
  <Code code={use} lang="html" label="Usage with Tailwind" />
  <p>ダークモードの値は <code>tokens.css</code> が同じ変数を再定義するため、<code>dark:</code> を書き足す必要はない。</p>
  <h2 id="theme">Theme</h2>
  <p>クラスを 1 つ作り、変数をオーバーライドする。CSS の生成には、<a href={href("customization/theme")}>Theme</a> の Try it セクションを使える。</p>
  <p>動作するサンプルは、リポジトリの <code>examples/tailwind</code> にある。</p>
</Base>
