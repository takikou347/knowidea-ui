---
import Base from "../../../layouts/Base.astro";
import Code from "../../../components/Code.astro";
import { colorNames, value, oklchStr, hex, themeStyle, pairs, pairRatio, core } from "../../../lib/theme.mjs";
import { links } from "../../../lib/paths.mjs";

const kinds = {
  color: { name: "Color", lead: "役割を表す名前の変数だけを参照する。ライトとダークは別々に決めており、反転では作らない。" },
  typography: { name: "Typography", lead: "書体は 3 つ。本文とふつうの見出しは IBM Plex Sans JP、ページの題と大きな見出しは Murecho、数字とコードは IBM Plex Mono。本文のサイズは 5 段階、大きな見出しは 2 段階。" },
  spacing: { name: "Spacing", lead: "4px を単位とした 7 段階。コンポーネントの間隔は、この段階から選択する。" },
  radius: { name: "Radius", lead: "角丸は 3 段階(4px、8px、12px)と、Chip 用の pill。大きさで段を分け、大きな角丸を一律には使わない。" },
  shadow: { name: "Shadow", lead: "影は、浮かび上がる要素(メニュー、ダイアログ、画面に固定されたバー)にだけ使う。" },
  motion: { name: "Motion", lead: "状態が変わるときだけ動かす。prefers-reduced-motion では動きを止める。" },
};
export function getStaticPaths() {
  return ["color", "typography", "spacing", "radius", "shadow", "motion"].map((kind) => ({ params: { kind } }));
}
const { kind } = Astro.params;
const k = kinds[kind];
const { href } = links(Astro.url.pathname);

const modes = [["light", "Light"], ["dark", "Dark"]];
const px = (t) => `${t.$value.value}${t.$value.unit}`;
const sizes = Object.entries(core.font.size).map(([n, t]) => [n, px(t), core.font.lineHeight[n].$value]);
const spaces = Object.entries(core.space).map(([n, t]) => [n, px(t)]);
const radii = Object.entries(core.radius).map(([n, t]) => [n, px(t)]);
const durationUse = { fast: "ホバー、フォーカス", state: "状態が変わるとき", enter: "大きな面(Sheet、引き出しの Drawer)の出入り", spin: "スピナーの 1 回転" };
const durations = Object.entries(core.motion.duration).map(([n, t]) => [n, px(t), durationUse[n] ?? t.$description]);
---
<Base title={`${k.name} tokens`} description={`${k.name} のトークン`}>
  <h1>{k.name} tokens</h1>
  <p class="lead">{k.lead}</p>
  <p>トークンは CSS 変数で、<code>knowidea-tokens/tokens.css</code> を読み込むと使える。コンポーネントは役割を表す名前の変数だけを参照し、素の値は参照しない。変更の方法は <a href={href("customization/theme")}>Theme</a> と <a href={href("customization/overriding")}>Overriding</a> を参照。</p>

  {kind === "color" && (
    <>
      <h2 id="colors">Colors</h2>
      <div class="panels">
        {modes.map(([t, label]) => (
          <div class="panel" style={themeStyle(t)}>
            <h3>{label}</h3>
            <div class="table-wrap">
              <table class="docs-table">
                <thead><tr><th>Name</th><th>OKLCH</th><th>HEX</th></tr></thead>
                <tbody>
                  {colorNames.map((n) => (
                    <tr>
                      <td><span class="sw" style={`background: var(--color-${n})`}></span><code>{n}</code></td>
                      <td class="num">{oklchStr(value(t, n))}</td>
                      <td class="num">{hex(value(t, n))}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
      <h2 id="roles">Roles</h2>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Variable</th><th>Usage</th></tr></thead>
          <tbody>
            <tr><td><code>--color-bg</code>、<code>--color-surface</code>、<code>--color-surface-2</code></td><td>画面の背景、カードや入力欄の背景、ホバー時や無効状態の背景</td></tr>
            <tr><td><code>--color-text</code>、<code>--color-text-muted</code></td><td>本文、補足(どちらもコントラスト比 4.5:1 以上)</td></tr>
            <tr><td><code>--color-line</code>、<code>--color-line-strong</code></td><td>区切り線、操作できる要素の枠線(3:1 以上)</td></tr>
            <tr><td><code>--color-primary</code>、<code>-hover</code>、<code>--color-on-primary</code></td><td>プライマリボタンと現在地。プライマリ面に載せる文字色</td></tr>
            <tr><td><code>--color-focus</code></td><td>フォーカスリング(2px)</td></tr>
            <tr><td><code>--color-info</code>、<code>success</code>、<code>warn</code>、<code>error</code>(と <code>-soft</code>)</td><td>意味を表す色。文字と背景の組になっている。必ずアイコンと文字を添える</td></tr>
          </tbody>
        </table>
      </div>
      <h2 id="contrast">Contrast ratios</h2>
      <p>本文は 4.5:1 以上、線とフォーカスリングは 3:1 以上。<code>pnpm --filter knowidea-tokens check</code> が同じ計算で判定する。</p>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Foreground</th><th>Background</th><th class="num">Required</th><th class="num">Light</th><th class="num">Dark</th></tr></thead>
          <tbody>
            {pairs.map(([fg, bg, need]) => {
              const l = pairRatio("light", fg, bg), d = pairRatio("dark", fg, bg);
              return (
                <tr>
                  <td><code>{fg}</code></td><td><code>{bg}</code></td><td class="num">{need}:1</td>
                  <td class={l >= need ? "num ok" : "num ng"}>{l.toFixed(2)}{l >= need ? " Pass" : " Fail"}</td>
                  <td class={d >= need ? "num ok" : "num ng"}>{d.toFixed(2)}{d >= need ? " Pass" : " Fail"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </>
  )}

  {kind === "typography" && (
    <>
      <h2 id="families">Font families</h2>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Variable</th><th>Typeface</th><th>Usage</th></tr></thead>
          <tbody>
            <tr><td><code>--font-sans</code></td><td>IBM Plex Sans JP、BIZ UDPGothic、Noto Sans CJK JP ほか</td><td>本文、ふつうの見出し、部品の文字</td></tr>
            <tr><td><code>--font-mono</code></td><td>IBM Plex Mono、JetBrains Mono、ui-monospace ほか</td><td>数字、コード</td></tr>
            <tr><td><code>--font-display</code></td><td style="font-family: var(--font-display); font-weight: var(--font-weight-display)">Murecho 800(KI Murecho)、IBM Plex Sans JP ほか</td><td>ページの題、大きな見出し、Jacket の題字だけ</td></tr>
          </tbody>
        </table>
      </div>
      <p>本文のウェイトは 400、見出しと強調は 600(<code>--font-weight-regular</code>、<code>--font-weight-strong</code>)。数字は等幅にして桁をそろえる(<code>font-variant-numeric: tabular-nums</code>)。</p>
      <h2 id="sizes">Sizes</h2>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Step</th><th class="num">Size</th><th class="num">Line height</th><th>Preview</th></tr></thead>
          <tbody>
            {sizes.map(([n, s, l]) => (
              <tr><td><code>--font-size-{n}</code></td><td class="num">{s}</td><td class="num">{l}</td><td style={`font-size: ${s}; line-height: ${l}`}>ひらがなと漢字、abcXYZ <span style="font-family: var(--font-mono)">1234567890</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <h2 id="display">Display sizes</h2>
      <p>画面の幅に付いてくる大きさ(<code>clamp()</code>)。1 画面に 1〜2 か所だけに使い、ほかの見出しは上の 5 段階のままにする。書体は <code>--font-display</code>、太さは <code>--font-weight-display</code>(800)。</p>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Step</th><th class="num">Size</th><th class="num">Line height</th><th>Usage</th></tr></thead>
          <tbody>
            <tr><td><code>--font-size-display-1</code></td><td class="num">40〜56px</td><td class="num">1.12</td><td>ページの題、番組や回の題。1 画面に 1 か所</td></tr>
            <tr><td><code>--font-size-display-2</code></td><td class="num">32〜44px</td><td class="num">1.2</td><td>節の頭の大きな見出し。このサイトのページの題</td></tr>
          </tbody>
        </table>
      </div>
      <p class="ki-display" style="margin-top: var(--space-4)">答えはまだ無い。</p>
      <p class="ki-display" data-size="2" style="margin-top: var(--space-3)">だから試す。</p>
      <p>書体は <code>knowidea-css</code> の <code>fonts.css</code>(<code>index.css</code> に入っている)がパッケージの中から配る。外の配信は使わない。太さ 800 の 1 つだけを、英数字とかな(約 26 KB)と漢字(約 260 KB)の 2 つに絞り、使う字が画面に出た時だけ読まれる。Murecho に無い字は IBM Plex Sans JP で出る。ライセンスは SIL Open Font License 1.1。</p>
      <p class="muted">本文は 3 段目(14px)。<a href={href("customization/theme")}>Theme</a> の fontSize を変えると、5 段階すべてが本文を基準にまとめて変わる。</p>
    </>
  )}

  {kind === "spacing" && (
    <>
      <h2 id="scale">Scale</h2>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Variable</th><th class="num">Value</th><th>Preview</th></tr></thead>
          <tbody>{spaces.map(([n, v]) => <tr><td><code>--space-{n}</code></td><td class="num">{v}</td><td><span style={`display:inline-block;height:12px;width:${v};background:var(--color-primary)`}></span></td></tr>)}</tbody>
        </table>
      </div>
      <p>Stack と Grid の <code>gap</code> には、この段階の番号(1〜7)を渡す。タップ領域の最小サイズは <code>--size-hit</code>(44px)。</p>
      <p class="muted">密度を comfortable にすると、2〜6 段目の余白が少し広がる(<a href={href("customization/theme")}>Theme</a>)。</p>
    </>
  )}

  {kind === "radius" && (
    <>
      <h2 id="scale">Scale</h2>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Variable</th><th class="num">Value</th><th>Preview</th><th>Usage</th></tr></thead>
          <tbody>
            {radii.map(([n, v]) => <tr><td><code>--radius-{n}</code></td><td class="num">{v}</td><td><span style={`display:inline-block;height:24px;width:48px;border:1px solid var(--color-line-strong);background:var(--color-surface-2);border-radius:${v}`}></span></td><td>{n === "1" ? "Checkbox、Badge、Status、Skeleton など小さな部品" : n === "2" ? "Button、入力欄、Select、Alert、メニューの項目" : n === "3" ? "Card、Dialog、Menu、Table の枠など面" : "Chip(全体を丸める)。角丸 0 のテーマでは 0 になる"}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p>Theme の radius は中(<code>--radius-2</code>)の値で、小は半分、大は 1.5 倍になる。既定の 8px は 4px、8px、12px になり、12px を超えると警告が出る。Focus の輪は角丸を持たず、要素の形に沿う。</p>
    </>
  )}

  {kind === "shadow" && (
    <>
      <h2 id="pop">Elevated surfaces</h2>
      <div class="demo"><div class="demo-stage"><div style="width: 200px; padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-3); box-shadow: var(--shadow-pop)">--shadow-pop</div></div></div>
      <p>影は 1 段階だけ(<code>--shadow-pop</code>)。メニュー、ダイアログ、画面に固定された SelectionBar に使う。ライトでは黒の 14%、ダークでは黒の 50%。1 つの要素に、影、枠線、背景色を重ねて飾らない。</p>
    </>
  )}

  {kind === "motion" && (
    <>
      <h2 id="durations">Durations and easing</h2>
      <div class="table-wrap">
        <table class="docs-table">
          <thead><tr><th>Variable</th><th class="num">Value</th><th>Usage</th></tr></thead>
          <tbody>
            {durations.map(([n, v, d]) => <tr><td><code>--motion-duration-{n}</code></td><td class="num">{v}</td><td>{d}</td></tr>)}
            <tr><td><code>--motion-ease</code></td><td class="num">cubic-bezier(0.2, 0, 0, 1)</td><td>すべての動きに共通のイージング</td></tr>
          </tbody>
        </table>
      </div>
      <p>動かすのは、ホバー、フォーカス、状態が変わるときだけ。終わらない脈動、数字のカウントアップ、すべてのセクションに同じ出現アニメーションを付けることは避ける。<code>prefers-reduced-motion: reduce</code> では、回転も含めてすべて止める。</p>
      <p>Sheet と引き出しの Drawer は、指で引くと指に付いて動く。これは操作そのものなので、動きを減らす設定でも残す。指を離した後に閉じる動きと戻る動きは、<code>--motion-duration-enter</code> が 0ms になって止まる。</p>
    </>
  )}

  <h2 id="use">Usage</h2>
  <Code lang="css" label="CSS example" code={`.my-panel {
  padding: var(--space-4);
  border: 1px solid var(--color-line);
  border-radius: var(--radius-3);
  background: var(--color-surface);
  color: var(--color-text);
}`} />
</Base>
