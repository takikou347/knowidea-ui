---
import Base from "../layouts/Base.astro";
import icons from "icons/dist/icons.json" with { type: "json" };
import { svg } from "icons/dist/render.mjs";
import all from "icons/dist/icons-data.json" with { type: "json" };
const groups = [];
for (const i of all.icons) {
  let g = groups.find((x) => x.id === i.group);
  if (!g) groups.push((g = { id: i.group, label: i.groupLabel, items: [] }));
  g.items.push(i);
}
const appLabel = { admin: "管理", logru: "Logru", ruleru: "Ruleru" };
const draw = (name, weight, size) => {
  const v = all.data[name][weight];
  const a = Object.entries(v.attrs).map(([k, x]) => `${k}="${x}"`).join(" ");
  return `<svg width="${size}" height="${size}" viewBox="${v.viewBox}" ${a} aria-hidden="true" focusable="false">${v.inner}</svg>`;
};
const custom = all.icons.filter((i) => i.custom).length;
const sets = [["phosphor", "Phosphor regular"], ["tabler", "Tabler outline"], ["lucide", "Lucide"]];
const html = (set, role, size) => svg(icons, set, role, size);
---
<Base title="アイコン" description="UI のアイコン 3 組の比較">
  <h1>アイコン</h1>
  <p>全 {all.icons.length} 個(Phosphor {all.icons.length - custom}、自作 {custom})。用途ごとに、20px(既定)、16px、16px の bold を並べる。名前、日本語、使うアプリで絞り込める。</p>
  <div class="filter">
    <label for="q">絞り込み</label>
    <input id="q" type="search" placeholder="名前、日本語、admin、logru、ruleru" autocomplete="off" />
    <span class="muted" id="count" aria-live="polite"></span>
  </div>
  {groups.map((g) => (
    <section class="grp" data-group>
      <h2>{g.label}<span class="muted n"> {g.items.length}</span></h2>
      <ul class="grid">
        {g.items.map((i) => (
          <li class="cell" data-key={`${i.name} ${i.ja} ${i.phosphor ?? "自作"} ${i.apps.join(" ")}`.toLowerCase()}>
            <div class="row">
              <span class="ic" set:html={draw(i.name, "regular", 20)}></span>
              <span class="ic" set:html={draw(i.name, "regular", 16)}></span>
              <span class="ic" set:html={draw(i.name, "bold", 16)}></span>
            </div>
            <div class="nm"><code>{i.name}</code>{i.custom && <span class="tag">自作</span>}</div>
            <div class="muted ja">{i.ja}</div>
            <div class="muted ja">{i.phosphor ?? "自作"} / {i.apps.map((a) => appLabel[a]).join("、")}</div>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <h2>3 組の比較(1b)</h2>
  <p>管理アプリで要る 16 個を、20px と 16px で 3 組並べる。おすすめは Phosphor の regular。選んだ理由は <code>packages/icons/README.md</code>。</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>役</th>{sets.map(([, label]) => <th colspan="2">{label}</th>)}</tr>
        <tr><th></th>{sets.map(() => (<><th>20px</th><th>16px</th></>))}</tr>
      </thead>
      <tbody>
        {icons.roles.map((r) => (
          <tr>
            <td>{r.ja}</td>
            {sets.map(([s]) => (
              <>
                <td><span class="ic" set:html={html(s, r.role, 20)} title={icons[s].icons[r.role].name}></span></td>
                <td><span class="ic" set:html={html(s, r.role, 16)}></span></td>
              </>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <h2>使い方</h2>
  <p>色は <code>currentColor</code>。文字と同じ色になる。枠や丸で囲まない。押せる所に使うときは、ボタンの大きさを 44px にする(アイコンの大きさではない)。</p>
</Base>
<style>
  .filter { display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap; margin: var(--space-4) 0; }
  .filter input { min-height: var(--size-hit); min-width: 18rem; padding: 0 var(--space-3); border: 1px solid var(--color-line-strong); border-radius: var(--radius-2); background: var(--color-surface); color: var(--color-text); font: inherit; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(176px, 1fr)); gap: var(--space-2); }
  .cell { border: 1px solid var(--color-line); border-radius: var(--radius-2); background: var(--color-surface); padding: var(--space-3); display: grid; gap: var(--space-1); align-content: start; }
  .row { display: flex; gap: var(--space-4); align-items: center; margin-bottom: var(--space-2); color: var(--color-text); }
  .nm { display: flex; gap: var(--space-2); align-items: center; }
  .tag { font-size: var(--font-size-1, 12px); color: var(--color-primary); }
  .ja { font-size: var(--font-size-2); }
  .n { font-size: var(--font-size-2); font-weight: var(--font-weight-regular); }
  [hidden] { display: none !important; }
  .ic { display: inline-flex; color: var(--color-text); }
</style>
<script>
  const q = document.getElementById("q");
  const count = document.getElementById("count");
  function run() {
    const t = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let n = 0;
    document.querySelectorAll("[data-group]").forEach((g) => {
      let any = false;
      g.querySelectorAll(".cell").forEach((c) => {
        const ok = t.every((w) => c.dataset.key.includes(w));
        c.hidden = !ok; if (ok) { any = true; n++; }
      });
      g.hidden = !any;
    });
    count.textContent = t.length ? n + " 個" : "";
  }
  q.addEventListener("input", run);
</script>
