{
  "name": "knowidea-tokens",
  "version": "0.10.1",
  "description": "KNOW IDEA UI のデザイントークン(DTCG、OKLCH)と createTheme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takikou347/knowidea-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://takikou347.github.io/knowidea-ui/",
  "bugs": {
    "url": "https://github.com/takikou347/knowidea-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "style-dictionary": "5.6.1"
  },
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./create-theme": {
      "types": "./src/create-theme.d.ts",
      "default": "./src/create-theme.mjs"
    },
    "./dist/*": "./dist/*",
    "./scripts/*": "./scripts/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "knowidea-theme": "./bin/knowidea-theme.mjs"
  }
}
