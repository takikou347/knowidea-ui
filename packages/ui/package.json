{
  "name": "knowidea-ui",
  "version": "0.11.0",
  "description": "KNOW IDEA UI の React の部品(Base UI が土台)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takikou347/knowidea-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://takikou347.github.io/knowidea-ui/",
  "bugs": {
    "url": "https://github.com/takikou347/knowidea-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "1.2.5"
  },
  "peerDependencies": {
    "knowidea-css": "workspace:^",
    "knowidea-icons": "workspace:^",
    "knowidea-tokens": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knowidea-css": "workspace:*",
    "knowidea-icons": "workspace:*",
    "knowidea-tokens": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
