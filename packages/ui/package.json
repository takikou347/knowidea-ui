{
  "name": "knowidea-ui",
  "version": "0.9.0",
  "description": "KNOW IDEA UI の React の部品(Base UI が土台)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takikou347/knowidea-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://takikou347.github.io/knowidea-ui/",
  "bugs": {
    "url": "https://github.com/takikou347/knowidea-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "knowidea-css": "workspace:^",
    "knowidea-icons": "workspace:^",
    "knowidea-tokens": "workspace:^"
  },
  "devDependencies": {
    "knowidea-css": "workspace:*",
    "knowidea-icons": "workspace:*",
    "knowidea-tokens": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
